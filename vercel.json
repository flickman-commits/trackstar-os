{
  "framework": "vite",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=1 npm ci --include=dev",
  "crons": [
    {
      "path": "/api/orders/actions?action=monday-pipeline",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/orders/actions?action=health-check",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/orders/actions?action=daily-design-update",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/sales/send-due",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/orders/auto-import",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/support/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/artelo-send",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/fulfillment-check",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/artelo-completed-check",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/research-agent",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/custom-statements",
      "schedule": "0 * 28-31 * *"
    },
    {
      "path": "/api/cron/bulk-runs",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/support-playbook",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/finance-sync",
      "schedule": "0 10-18 * * *"
    },
    {
      "path": "/api/cron/hours-reminders",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/support-triage",
      "schedule": "0 12-22 * * *"
    }
  ],
  "functions": {
    "api/app.js": {
      "maxDuration": 300
    },
    "api/admin.js": {
      "maxDuration": 300
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 300
    },
    "api/public.js": {
      "maxDuration": 300
    },
    "api/sales.js": {
      "maxDuration": 300
    },
    "api/support.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "creator.trackstar.art"
        }
      ],
      "destination": "/apply",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/approve/:token",
      "destination": "/api/public?__route=public/approval-preview&token=:token"
    },
    {
      "source": "/vote/:token",
      "destination": "/api/public?__route=public/survey-preview&token=:token"
    },
    {
      "source": "/apply",
      "destination": "/api/public?__route=public/creator-preview"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/cron?__route=cron/$1"
    },
    {
      "source": "/api/public/(.*)",
      "destination": "/api/public?__route=public/$1"
    },
    {
      "source": "/api/support/(.*)",
      "destination": "/api/support?__route=support/$1"
    },
    {
      "source": "/api/sales/(.*)",
      "destination": "/api/sales?__route=sales/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin?__route=admin/$1"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/admin?__route=auth/$1"
    },
    {
      "source": "/api/finance/(.*)",
      "destination": "/api/admin?__route=finance/$1"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/mcp?__route=mcp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/app?__route=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
