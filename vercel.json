{
  "framework": "vite",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=1 npm ci --include=dev",
  "crons": [
    {
      "path": "/api/orders/actions?action=monday-pipeline",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/orders/actions?action=health-check",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/orders/actions?action=daily-design-update",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/sales/send-due",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/orders/auto-import",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/support/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/artelo-send",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/fulfillment-check",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/artelo-completed-check",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/research-agent",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/custom-statements",
      "schedule": "0 * 28-31 * *"
    }
  ],
  "functions": {
    "api/cron/fulfillment-check.js": {
      "maxDuration": 120
    },
    "api/cron/artelo-completed-check.js": {
      "maxDuration": 300
    },
    "api/cron/research-agent.js": {
      "maxDuration": 300
    },
    "api/admin/**/*.js": {
      "maxDuration": 300
    },
    "api/mcp/**/*.js": {
      "maxDuration": 300
    },
    "api/bulk/**/*.js": {
      "maxDuration": 300
    },
    "api/sales/**/*.js": {
      "maxDuration": 300
    },
    "api/support/{sync,backfill,instagram}.js": {
      "maxDuration": 300
    },
    "api/support/*.js": {
      "maxDuration": 60
    },
    "api/orders/actions.js": {
      "maxDuration": 300
    },
    "api/orders/auto-import.js": {
      "maxDuration": 300
    },
    "api/orders/import.js": {
      "maxDuration": 300
    },
    "api/orders/research-runner.js": {
      "maxDuration": 300
    },
    "api/orders/refresh-shopify-data.js": {
      "maxDuration": 300
    },
    "api/orders/refresh-etsy-data.js": {
      "maxDuration": 300
    },
    "api/public/results-lookup.js": {
      "maxDuration": 300
    },
    "api/auth/**/*.js": {
      "maxDuration": 60
    },
    "api/creators/**/*.js": {
      "maxDuration": 60
    },
    "api/etsy/**/*.js": {
      "maxDuration": 60
    },
    "api/products/**/*.js": {
      "maxDuration": 60
    },
    "api/proofs/**/*.js": {
      "maxDuration": 60
    },
    "api/render/**/*.js": {
      "maxDuration": 60
    },
    "api/surveys/**/*.js": {
      "maxDuration": 60
    },
    "api/orders/assign.js": {
      "maxDuration": 60
    },
    "api/orders/excluded-products.js": {
      "maxDuration": 60
    },
    "api/orders/cancel-creator-sample.js": {
      "maxDuration": 60
    },
    "api/orders/comments.js": {
      "maxDuration": 60
    },
    "api/orders/final-pdf.js": {
      "maxDuration": 60
    },
    "api/orders/artelo-send.js": {
      "maxDuration": 60
    },
    "api/orders/change-frame.js": {
      "maxDuration": 60
    },
    "api/orders/gift-stats.js": {
      "maxDuration": 60
    },
    "api/orders/index.js": {
      "maxDuration": 60
    },
    "api/orders/photo.js": {
      "maxDuration": 60
    },
    "api/orders/refresh-weather.js": {
      "maxDuration": 60
    },
    "api/orders/rush.js": {
      "maxDuration": 60
    },
    "api/orders/update.js": {
      "maxDuration": 60
    },
    "api/public/approval-preview.js": {
      "maxDuration": 60
    },
    "api/public/bulk-intake.js": {
      "maxDuration": 60
    },
    "api/public/creator-preview.js": {
      "maxDuration": 60
    },
    "api/public/creator.js": {
      "maxDuration": 60
    },
    "api/public/monopoly.js": {
      "maxDuration": 60
    },
    "api/public/photo-upload-url.js": {
      "maxDuration": 60
    },
    "api/public/photo-verify.js": {
      "maxDuration": 60
    },
    "api/public/race-status.js": {
      "maxDuration": 60
    },
    "api/public/survey-preview.js": {
      "maxDuration": 60
    },
    "api/public/survey.js": {
      "maxDuration": 60
    },
    "api/races/**/*.js": {
      "maxDuration": 60
    },
    "api/cron/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "creator.trackstar.art"
        }
      ],
      "destination": "/apply",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/approve/:token",
      "destination": "/api/public/approval-preview?token=:token"
    },
    {
      "source": "/vote/:token",
      "destination": "/api/public/survey-preview?token=:token"
    },
    {
      "source": "/apply",
      "destination": "/api/public/creator-preview"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
