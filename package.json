{
  "name": "trackstaros",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "worker": "node worker/render-worker.mjs",
    "dev": "concurrently -n api,vite -c blue,green \"npm run dev:api\" \"npm run dev:vite\"",
    "routes": "node scripts/gen-routes.js",
    "dev:api": "node --env-file=.env.local server/dev.js",
    "dev:vite": "vite",
    "build": "node scripts/check-vercel-config.js && node scripts/gen-routes.js --check && node scripts/check-auth-await.js && npm run lint && npm run lint:server && node scripts/lint-scrapers.js && prisma generate && npm test && tsc && vite build",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 5",
    "lint:server": "eslint server api scripts worker middleware.js --max-warnings 0",
    "lint:scrapers": "node scripts/lint-scrapers.js",
    "test:scrapers": "node scripts/verify-scraper-chip-times.js",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "DATABASE_URL=postgresql://offline:offline@127.0.0.1:1/offline DIRECT_URL=postgresql://offline:offline@127.0.0.1:1/offline node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@googleapis/drive": "^26.0.2",
    "@googleapis/gmail": "^22.0.2",
    "@googleapis/sheets": "^18.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.3.0",
    "@sparticuz/chromium": "^143.0.4",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/edge": "^1.3.3",
    "@vercel/functions": "^1.5.2",
    "cheerio": "^1.2.0",
    "formidable": "^3.5.4",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.303.0",
    "pdfjs-dist": "^5.5.207",
    "prisma": "^6.3.0",
    "puppeteer-core": "^24.37.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "resend": "^6.9.4",
    "sharp": "^0.35.5",
    "sonner": "^1.7.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "express": "^4.21.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.0",
    "prettier": "^3.1.1",
    "puppeteer": "^24.43.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.0.8"
  }
}
