// Trackstar Database Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    // Order number for this specific item (parentOrderNumber-lineItemIndex)
  parentOrderNumber  String    // Original Shopify/Etsy order number
  lineItemIndex      Int       @default(0) // Which line item this is (0, 1, 2, etc.)
  source             String    // "shopify" or "etsy"
  arteloOrderData    Json      // Full order object from Artelo
  shopifyOrderData   Json?     // Personalization data if Shopify
  etsyOrderData      Json?     // Receipt/personalization data if Etsy
  raceName           String
  raceYear           Int
  runnerName         String
  productSize        String
  frameType          String
  notes              String?   // Notes from Shopify (year corrections, etc.)
  hadNoTime          Boolean   @default(false) // Flag: customer entered "no time" in runner name
  status             String    @default("pending") // "pending", "missing_year", "ready", "flagged", "completed"
  researchedAt       DateTime?
  createdAt          DateTime  @default(now())

  // Trackstar order classification
  trackstarOrderType String    @default("standard") // "standard" | "custom" | "race_partner" | "bulk" | "sample" (overseas sample design)
  // Note: race_partner rows reuse raceName as the partner name and
  // customerName/customerEmail as the partner contact — no schema change needed.

  // Custom order fields (populated from Shopify properties for custom orders)
  designStatus       String    @default("not_started") // "not_started" | "in_progress" | "awaiting_review" | "ready_to_send" | "done"
  dueDate            DateTime? // Computed: order created_at + 14 days (4 if isRushOrder)
  // "Skip the line": the customer paid the rush fee, so this order is promised
  // in 4 days instead of 14 and should be designed first. Set from the rush
  // add-on line item / the print's Rush Order property at import.
  isRushOrder        Boolean   @default(false)
  // An admin moved this order to rush by hand (comped or arranged off-site).
  // The import's paid-rush check never undoes it.
  rushOverride       Boolean   @default(false)
  customerEmail      String?   // Customer email from Shopify order
  customerName       String?   // Customer first name from Shopify order (for email template)
  bibNumberCustomer  String?   // Bib # provided by customer (custom orders only)
  timeCustomer       String?   // Time provided by customer (custom orders only)
  creativeDirection  String?   // Creative direction notes from customer
  isGift             Boolean   @default(false) // Whether this is a gift order
  proofSentAt        DateTime? // When proofs were last sent to customer (for follow-up tracking)
  designerNote       String?   // Optional note from designer sent with proofs (shown in approval portal)
  // Custom-order delay notification (Dan's "Notify Customer of Delay" button)
  delayNoticeSentAt  DateTime? // When the delay-notice email was sent
  delayNoticeDaysLate Int?     // How many days late we promised in that email

  // Shipping. Currently used by creator-sample orders to surface a real
  // "shipped" signal in the creator portal (status='completed' means "sent to
  // production", which is not the same as out-the-door).
  trackingNumber     String?
  trackingCarrier    String?   // Free-text: "USPS", "UPS", "FedEx", etc.
  shippedAt          DateTime?

  // Customer-confirmed race result, captured by the storefront Instant Lookup
  // widget on STANDARD race orders. Distinct from bibNumberCustomer/timeCustomer
  // above (those are free-text fields for CUSTOM "any race" orders).
  //   lookupVerified = true  → customer confirmed an official-results match
  //                            (same data the scraper would find, human-verified)
  //                  = false → customer typed it manually (still research as fallback)
  //                  = null  → no widget data (Etsy, or a PDP without the widget)
  //                            → research runs normally, exactly as before.
  // Phase 1 reads these to skip research when verified; Phase 0 only captures them.
  lookupVerified     Boolean?  // Did the data come from a confirmed official match?
  customerBib        String?   // Bib # from the widget (verified or manual)
  customerFinishTime String?   // Finish time from the widget (verified or manual)
  customerPace       String?   // Pace from the widget (only set on a verified match)
  customerEventType  String?   // Event/distance from the widget (e.g. "Marathon")
  // How the shopper arrived at their confirmed/typed result. Drives the
  // "outcome" chip on the order detail and helps debug widget behavior.
  //   "auto_match"          → single official-results match, customer confirmed
  //   "picked_from_list"    → multiple matches, customer picked one
  //   "manual_no_match"     → lookup ran, returned nothing → typed it in
  //   "manual_lookup_error" → endpoint errored / unreachable → typed it in
  //   "manual_rate_limited" → 429 → typed it in
  //   "manual_user_choice"  → customer chose "Enter info manually" themselves
  //   "edited_by_customer"  → matched, then the customer changed time/pace/bib
  //   "<outcome>_name_edited" (e.g. "auto_match_name_edited") → verified match,
  //                           customer changed only the NAME on the print;
  //                           time, pace and bib are still the official ones
  //   null                  → no widget data (Etsy / pre-widget order)
  lookupOutcome      String?
  // The runner name official results matched, set only when the customer then
  // printed a different name ("Jonathan Smith" for a result listed as "Jon
  // Smith"). Lets whoever fulfills the order see both. From the hidden cart
  // property _matched_name.
  lookupMatchedName  String?

  // Personalization photo, captured by the storefront wizard's photo step.
  // Stores the Supabase Storage PATH, never a URL: the bucket is private and a
  // durable public link to a customer's photo is a privacy problem we could not
  // walk back. The dashboard mints a short-lived signed URL on demand via
  // /api/admin/photo-signed-url when a designer opens the order.
  //   null → no photo on this order (the overwhelming majority)
  photoPath          String?
  // A photo an admin attached after purchase (the customer emailed it). It
  // only counts as paid once the Shopify order carries a paid Photo Add-On
  // line for it; until then the order shows "Photo not paid" and cannot be
  // completed.
  photoAddedManually Boolean  @default(false)
  // A hand-attached photo we are not charging for (Settings in the order
  // view: "Photo is free"). Counts as paid, renders with the photo, and
  // never needs a Photo Add-On line on the Shopify order.
  photoFree          Boolean  @default(false)
  // Why Artelo is holding this order, when it is ("Missing Designs", "Needs
  // Address Review", "Customer Unpaid"); null when it is not. Set by the
  // import's hold check and the daily Artelo check (arteloMismatch.js); the
  // Action queue shows it, since nothing prints until someone acts in Artelo.
  arteloHold         String?
  // Custom Counter: a design we have made before pays half. Null = decided
  // automatically (an earlier custom for the same race and distance); true or
  // false = set by hand in the counter (customCounter.js).
  designRepeat       Boolean?
  // The customer's answer on the approval page to "Can we feature this
  // design on our site?" (custom orders). Null = approved before the
  // question existed. False keeps it out of Settings > Site Gallery.
  featureConsent     Boolean?
  // Set when a designer confirms the customer's photo is actually placed on
  // the artwork. A photo order that ships without the photo is a reprint and a
  // refund, and the photo is the one element no proof template shows by
  // default, so it needs an explicit human check rather than an assumption.
  // Null on every order without a photo.
  photoPlacedAt      DateTime?

  // Manual override fields (for customer corrections)
  yearOverride       Int?      // Override for raceYear
  raceNameOverride   String?   // Override for raceName
  runnerNameOverride String?   // Override for runnerName

  // Relations
  runnerResearch   RunnerResearch[]
  comments         OrderComment[]
  approvalToken    ApprovalToken?
  proofs           Proof[]
  messages         OrderMessage[]
  creatorSample    Creator?  @relation("CreatorSample") // Set iff this is a creator-program sample order
  // Bulk partner orders: one runner per row, grouped under a BulkOrder. The
  // address is the runner's own; every print ships separately.
  // Who is fulfilling this order. Set on import from the per-type default
  // (SystemConfig "assignment_defaults"), changeable by anyone on the team.
  assigneeId       String?
  assignee         User?      @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Custom design payouts: who moved this order to Sent to Production, and
  // when. Cleared if it is reopened. Older rows have neither; the counter
  // falls back to researchedAt and the assignee for those.
  designCompletedAt   DateTime?
  designCompletedById String?
  designCompletedBy   User?    @relation("DesignCompletedBy", fields: [designCompletedById], references: [id], onDelete: SetNull)
  bulkOrderId      String?
  bulkOrder        BulkOrder? @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)
  renderJobs       RenderJob[]
  galleryPick      GalleryPick?
  shippingAddress  Json?      // { line1, line2, city, state, zip, country }
  productionFileUrl String?   // Public URL of the finished print file, for the Artelo sheet

  @@unique([parentOrderNumber, lineItemIndex]) // Each line item is unique within an order
  @@index([orderNumber])
  @@index([parentOrderNumber]) // For grouping items from same order
  @@index([status])
  @@index([raceName, raceYear])
  @@index([trackstarOrderType])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([dueDate])
  @@index([isRushOrder])
  @@index([designStatus])
  @@index([assigneeId])
  // The order list: open orders of a type, newest first (api/orders/index.js).
  @@index([status, trackstarOrderType, createdAt])
}

model Race {
  id               Int       @id @default(autoincrement())
  raceName         String
  year             Int
  raceDate         DateTime? // null = nobody has verified one yet. Never a placeholder.
  // Where raceDate came from: "manual" (a person typed it, which only happens
  // once they have confirmed it on the results site), "config" (a verified
  // raceDates pin), "scraped" (read off the results page), "researched"
  // (confirmed against a cited source: official site, results, news). Null on rows that
  // predate this column, which may still hold a value from the old computed
  // rules - those are the ones the sweep should keep asking about.
  raceDateSource   String?
  // The evidence: where the date was confirmed (a results page, the official
  // site, a race-day report) and what it said. A date prints only when it has
  // this. Set by a person in the tool, the config sync, or the nightly routine.
  raceDateSourceUrl   String?
  raceDateEvidence    String?
  raceDateVerifiedAt  DateTime?
  raceDateVerifiedBy  String?   // user id, "config", "nightly", or a script name
  raceDateConfirmedByPerson String? // name of the person who confirmed a suggested (scraped) date; cleared when the date changes
  // Set the first time a print made from this race year is approved. After
  // that the date and weather are locked: a change needs a reason, is logged,
  // and flags every open render made with the old values.
  firstPrintedAt   DateTime?
  eventTypes       Json      // Array like ["Marathon", "Half Marathon"]
  resultsUrl       String?
  resultsSiteType  String?
  location         String?
  weatherCondition String?   // "sunny", "cloudy", "rainy", or "snowy"
  weatherTemp      String?
  weatherFetchedAt DateTime?
  weatherDetails   String?   // JSON breakdown of how the weather was calculated (for the info popover)
  // Calculated weather is checked by a person before it prints (Confirm in the order view). Any change clears it.
  weatherConfirmedAt DateTime?
  weatherConfirmedBy String?
  createdAt        DateTime  @default(now())

  // Relations
  runnerResearch   RunnerResearch[]

  @@unique([raceName, year])
  @@index([raceName])
  @@index([year])
}

model RunnerResearch {
  id             Int      @id @default(autoincrement())
  orderId        String   // Changed to orderId to link to Order.id instead
  raceId         Int
  runnerName     String
  bibNumber      String?
  officialTime   String?
  officialPace   String?
  // Triathlons only (server/domain/orders/triathlon.js): each leg's time and
  // distance as they print ("00:40:15", "1.5 mi"), entered by hand.
  swimTime       String?
  swimDistance   String?
  bikeTime       String?
  bikeDistance   String?
  runTime        String?
  runDistance    String?
  eventType      String?  // "Marathon" or "Half Marathon"
  yearFound      Int?
  researchStatus String   @default("pending") // "found", "not_found", "ambiguous", "no_scraper", "year_not_configured", "upstream_error"
  // How this result was obtained:
  //   "scraper"           → found by the backend research scrape (default)
  //   "customer_verified" → customer confirmed an official-results match in the
  //                         storefront Instant Lookup widget (no runner scrape)
  //   "customer_supplied" → customer typed or edited the numbers themselves.
  //                         Used as given, but never matched against official
  //                         results, so the dashboard says so.
  source         String   @default("scraper")
  researchNotes  String?
  resultsUrl     String?  // URL where this runner's results were found
  // Candidate matches surfaced when no exact name match was found. Each item:
  // { name, bib?, time?, pace?, city?, state?, eventType?, resultsUrl? }
  // The dashboard renders these as Accept-button rows so the user can pick.
  possibleMatches Json?
  createdAt      DateTime @default(now())

  // Relations
  order          Order    @relation(fields: [orderId], references: [id])
  race           Race     @relation(fields: [raceId], references: [id])

  @@index([orderId])
  @@index([raceId])
  @@index([researchStatus])
}

// A partner's bulk order of prints for one race: who pays and the invoice, the runner list,
// the co-branded production file, and the Artelo sheet that ships it. Runners
// are real Order rows (trackstarOrderType "bulk") so research, weather, the
// filename convention and the order modal all work on them unchanged.
model BulkOrder {
  id                String    @id @default(cuid())
  number            String    @unique   // "BULK-0001", the parentOrderNumber on its runners
  partnerName       String
  raceName          String
  raceYear          Int
  quantity          Int       @default(0) // What was invoiced; the runner count may differ
  frameType         String    @default("Natural Premium Oak") // Artelo framing value
  productSize       String    @default("12x18")
  stripeInvoiceUrl  String?   // Older orders: the Stripe payment link (new ones are invoiced through Shopify below)
  paidAt            DateTime?
  // The Shopify order that paid for this run: a draft order tagged "bulk"
  // (plus this run's number, e.g. "BULK-0003", to link one made here first).
  shopifyOrderId    String?   @unique
  shopifyOrderName  String?   // "#4412"
  productionFileUrl String?   // Google Drive link to the co-branded Illustrator file
  previewImageUrl   String?   // What the finished print should look like
  raceDate          DateTime?
  dueDate           DateTime? // raceDate + 3 days unless set by hand
  status            String    @default("collecting") // collecting | fulfillment | submitted
  submittedAt       DateTime?
  intakeToken       String    @unique @default(cuid()) // /intake/<token> for the partner
  runnerToken       String    @unique @default(cuid()) // /runner/<token>: each runner submits their own name and address
  intakeNote        String?   // Shown to the partner on the intake page
  notes             String?
  partnerOrderId    String?   // The race_partner design order this belongs to, if any
  // The event at the race ("Marathon", "Half Marathon", "8K") on older
  // orders; research searches that event for its runners.
  eventType         String?
  // Who runs it. New ones go to the bulk default (Order Assignment settings).
  assigneeId        String?
  assignee          User?     @relation("BulkAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Who is paying and what we agreed, and the Shopify invoice
  // (server/domain/bulk/billing.js). Money in integer units only (CLAUDE.md).
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  billingAddress    Json?     // { company, name, address1, address2, city, province, zip, country }
  printKind         String    @default("standard") // standard: our race design, rendered by the worker; cobranded: theirs, from its own production file
  events            String?   // Internal: which events were sold ("Full 5, Half 5, 10K 3"); the lookup finds each runner's
  discountKind      String?   // percent | amount
  discountPercent   Int?      // 15 = 15% off
  discountCents     Int?      // 5000 = $50.00 off
  currency          String    @default("USD")
  discountNote      String?   // Why we gave it; never on the invoice
  shipping          String    @default("runner") // runner: each print to its runner; organization: all to shipToAddress
  shipToAddress     Json?
  shopifyDraftId    String?   // The Shopify draft order it is invoiced with; tagged "bulk" and this number
  shopifyDraftName  String?   // "#D72"
  invoiceUrl        String?   // The customer's checkout link
  invoiceSentAt     DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  runners           Order[]

  @@index([dueDate])
  @@index([status])
}

model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  text      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  // Who wrote it. Nullable because every comment written before sign-ins
  // existed has no author, and inventing one would be a lie.
  authorId   String?
  authorName String?

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Two-way Q&A between the designer (Dan) and the customer for a custom order.
// The designer asks a question in the backend portal → the customer answers in
// the same token-gated approval portal they use for proofs → Dan gets pinged.
// No inbound email: the customer's reply is a token-validated POST from the
// portal, exactly like a proof revision request.
model OrderMessage {
  id             String   @id @default(cuid())
  orderId        String
  sender         String   // "designer" | "customer"
  body           String
  readByDesigner Boolean  @default(false) // false when a customer reply is awaiting Dan
  createdAt      DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ApprovalToken {
  id        String   @id @default(cuid())
  orderId   String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Proof {
  id               String   @id @default(cuid())
  orderId          String
  version          Int
  batch            Int      @default(1) // Which send-round this proof belongs to (1 = first send, 2 = first revision, etc.)
  // What this proof is an option FOR, e.g. "Half Marathon" / "Marathon".
  //
  // Partner orders often carry several products at once and the partner is meant
  // to choose one design per product, not one design overall. Approval and
  // revision are scoped to this label, so options for one product no longer
  // reject options for another.
  //
  // Null means "the only thing on this order", which is every custom and
  // standard order. Those keep exactly the old behaviour without a special
  // case: one unnamed group, one approval, everything else rejected.
  groupLabel       String?
  imageUrl         String
  thumbnailUrl     String?  // Compressed ~200px thumbnail for grid views (saves egress bandwidth)
  fileName         String?
  status           String   @default("pending") // "pending" | "approved" | "revision_requested"
  customerFeedback String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Public Instant Lookup attempts, persisted so the admin "Recent Lookups"
// panel can see EVERY lookup regardless of which serverless instance handled
// it. In-memory ring buffers are per-function in Vercel, so they were invisible
// to the admin endpoint — this table replaces them.
//
// Names and IPs are anonymized before write (e.g. "M.H.(11)", "73.21.x.x").
// No PII stored. Indexed for fast "last N" + "by race" queries.
model LookupLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  race      String?
  year      Int?
  name      String   // anonymized: "M.H.(11)"
  outcome   String   // found | suggestions | time_unavailable | not_found | off | upstream_error | rate_limited | bad_request | cached
  status    Int?
  ms        Int?
  ip        String   // anonymized: "73.21.x.x"
  cached    Boolean  @default(false)

  @@index([createdAt])
  @@index([race, createdAt])
}

// One probe result per race+year. Written by the scraper-health probe, which
// runs on a cron and does NOT wait for a shopper to stumble onto a broken race.
//
// This is the supply side of scraper visibility. LookupLog is the demand side:
// it only ever records races somebody actually shopped, so a race with no
// traffic and a race that works look identical there (both blank). At four
// live races that was survivable. With every HTTP-safe race live it is not,
// because traffic concentrates on a handful of products and the rest go dark.
//
// Keyed by race AND year because "does this scraper work" has no single
// answer: Austin has event ids for 2026 only, SF serves 2026 from ChronoTrack
// and 2022-2025 from an Athlinks fallback. A race is not healthy or broken, a
// race-year is.
model ScraperHealth {
  id        Int      @id @default(autoincrement())
  race      String   // canonical race name, e.g. "Boston Marathon"
  year      Int
  checkedAt DateTime @default(now())

  // live      → probe found the known runner and the bib matched
  // drifted   → probe found the runner but the bib did NOT match. The site is
  //             up and parsing "succeeds", so nothing else catches this, and
  //             it is the failure that reaches a printed poster.
  // broken    → scraper threw, timed out, or the timing site errored
  // no_year   → config has no event id for this year (a config gap, not a bug)
  // no_probe  → configured and reachable, but we have no known finisher to
  //             assert against, so this is "untested", not "passing"
  // ineligible→ Puppeteer platform; cannot run on the public endpoint at all
  status    String

  // What we asserted against, so a failure is debuggable without a re-run.
  probeName String?
  expectBib String?
  actualBib String?

  ms        Int?
  detail    String?  // error message / notes
  platform  String?  // which scraper ran, incl. whether a fallback was used

  @@unique([race, year])
  @@index([status])
  @@index([checkedAt])
}

// The store's product catalog, synced from Shopify. ONE source of truth for
// "what do we sell".
//
// This replaces a 250-line hand-maintained map in server/lib/productCatalog.js.
// That map had already drifted: four live products missing (both triathlon
// prints, Missoula, Relay for America) and stale entries for products since
// renamed. Every drift showed up as a missing hero image on Eli's queue and as
// a tooltip asking a human to go edit a source file.
//
// It is also the denominator the scraper-health view was missing. Coverage
// measured against scraper configs answers "of the races we built scrapers
// for, how many work", which silently excludes every race we sell and never
// wrote a scraper for. There are seven of those today (Memphis, Honolulu, San
// Antonio, Las Vegas, Detroit, Palm Beaches, Baltimore) and nothing in the
// system said so.
model ShopifyProduct {
  id             Int      @id @default(autoincrement())
  productId      String   @unique // Shopify numeric id, as it appears on line items
  handle         String   @unique
  title          String
  status         String?  // ACTIVE | DRAFT | ARCHIVED
  templateSuffix String?  // which PDP template — tells us if the wizard is on it
  featuredImage  String?
  tags           Json?

  // Canonical race this product sells, resolved through the same chain the
  // storefront lookup uses (parseRaceNameFromTitle → getCanonicalRaceName).
  // Null means either a non-race product (gift card, Custom) or a race we sell
  // with no scraper — the panel distinguishes those, since only one is a gap.
  raceCanonical  String?

  syncedAt       DateTime @updatedAt

  @@index([raceCanonical])
  @@index([status])
}

// Per-race-year scraper config the dashboard can write.
//
// Event ids live in git-tracked files under server/scrapers/configs, and
// Vercel's filesystem is read-only, so a "fix this" button in the dashboard
// physically cannot edit them. These rows layer on top instead: they are
// merged into the config at scraper-construction time, through the
// yearOverrides hook createScraper already had.
//
// Only event ids. Anything structural (a new platform, new parsing) is still
// a code change, and should be — a button that could invent a scraper would
// be a button that could quietly invent wrong results.
model ScraperOverride {
  id         Int      @id @default(autoincrement())
  race       String   // canonical race name
  year       Int
  // Platform-shaped, matching what the config would have held: a bare id for
  // Athlinks/Xacte, { marathon, halfMarathon } for MyChipTime.
  eventIds   Json
  // Which scraper this applies to. Null means the primary; set it to target a
  // config's `fallback` instead.
  platform   String?
  source     String   // discovered | manual
  note       String?
  // Set once a probe has confirmed the id actually returns the runner we
  // expect. An unverified override is a guess, and the panel says so.
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([race, year])
  @@index([race])
}

// Known finishers to assert probes against.
//
// RunnerResearch already supplies these for races we have SOLD, which is where
// the probe's fixtures come from today. It cannot supply them for a race we
// just added, and 17 races were reporting "untested" forever as a result.
// Capturing one finisher from a live search fills that gap: the capture itself
// proves the scraper works right now, and every probe after it proves the
// scraper has not drifted since.
// Not every platform exposes a bib. Berlin (Mika) returns finishers with an
// empty bib field and a valid finish time, so a bib-only fixture could never
// be captured there. Assert on whichever identifier the platform actually
// gives us; a wrong time is just as good a drift signal as a wrong bib.
model ScraperFixture {
  id           Int      @id @default(autoincrement())
  race         String
  year         Int
  runnerName   String
  bib          String?
  officialTime String?
  source       String   // captured | manual
  capturedAt   DateTime @default(now())

  @@unique([race, year])
  @@index([race])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Trackstar Creator Program
// -----------------------------------------------------------------------------
// A Creator is a person Matt invites to the program. They receive an invite
// link, land on the onboarding wizard, submit their race info + shipping, and
// get a free sample print. The sample is fulfilled through the existing
// Standard order queue (source = "creator_sample") so Elí processes it like
// any other standard order.
//
// Future phases add: briefs, content submissions, Meta ad tagging, attribution,
// and commission tracking. Those live in their own tables (added later).
model Creator {
  id                  String    @id @default(cuid())

  // Invite + portal access. Token doubles as the creator's persistent portal
  // credential — they bookmark /creator/<token> and return to it anytime.
  inviteToken         String    @unique
  invitedAt           DateTime  @default(now())
  onboardedAt         DateTime?

  // Profile (populated at onboarding)
  name                String?
  email               String?
  instagramHandle     String?
  tiktokHandle        String?

  // Application questions (the public landing page is framed as an
  // application — both fields collected during /apply onboarding).
  //   bestContentLinks: pasted URLs / handles of their best UGC examples
  //   whyWorkWithUs:    optional freeform pitch from the applicant
  bestContentLinks    String?
  whyWorkWithUs       String?

  // Race info for the sample print (required for the personalization)
  raceName            String?
  raceYear            Int?
  bibNumber           String?
  finishTime          String?

  // Product preferences for the sample
  // The exact store print they picked ("Personalized Berlin World Major Race
  // Poster"), from the shared catalog; raceName is that print's race.
  productTitle        String?
  productSize         String?
  frameType           String?

  // Shipping address
  shippingName        String?
  shippingAddress1    String?
  shippingAddress2    String?
  shippingCity        String?
  shippingState       String?
  shippingZip         String?
  shippingCountry     String?   @default("US")

  // Commission — flexible per creator. Matt sets these manually after onboarding.
  //   commissionModel: "free_product" | "flat_per_asset" | "rev_share" | "hybrid"
  //   commissionConfig: JSON e.g. { "per_asset_usd": 50, "percent": 10 }
  commissionModel     String    @default("free_product")
  commissionConfig    Json      @default("{}")
  commissionNotes     String?

  // Free-form admin notes about the creator (anything Matt wants to jot down).
  notes               String?

  // Whitelisting (Meta Partnership Ads). Optional — off by default.
  whitelistingEnabled Boolean   @default(false)
  metaPageId          String?

  // How this row was created:
  //   "admin_invite" → Matt generated an invite link in /creators
  //   "public_apply" → minted when someone clicked Apply on the public /apply page
  // Used to hide abandoned public applications (public_apply + never onboarded)
  // from the admin table so they don't clutter it with blank rows.
  source              String    @default("admin_invite")

  // Workflow status
  status              String    @default("invited") // "invited" | "applied" | "active" | "paused" | "denied"

  // Content delivery status — tracks whether the creator has handed over the
  // promised content. Distinct from `status` (which is program-level).
  //   "not_received" | "received" | "edited" | "posted"
  contentStatus       String    @default("not_received")

  // Link to the Standard Order that fulfills their sample.
  sampleOrderId       String?   @unique
  sampleOrder         Order?    @relation("CreatorSample", fields: [sampleOrderId], references: [id])
  // Samples sent as Shopify orders (the Samples flow), newest last. The order
  // reaches our Order table on the next import; sampleOrder is then linked to
  // the newest one (server/domain/creators/creatorSample.js linkCreatorSamples).
  sampleShopifyOrderIds String[] @default([])

  // Briefs assigned to this creator — selected by Matt at invite time.
  briefAssignments    BriefAssignment[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([email])
}

// A Brief describes a style of content Matt wants creators to film. Matt
// curates these in /briefs and assigns them to creators at invite time (or
// later). The creator portal shows their assigned briefs as the directive
// for what to shoot.
model Brief {
  id             String   @id @default(cuid())
  title          String
  description    String?                // overall goal / context
  styleOfVideo   String?                // e.g. "POV reveal", "talking head"
  angle          String?                // messaging angle
  targetLength   String?                // e.g. "15-30s", "60-90s"
  // Information framework — "guardrails, not scripts". Creators get the
  // framework, not a line-by-line script, and find their own voice inside it.
  hooks          String?                // opening lines / hook options (newline-separated)
  emotion        String?                // the emotional lever the content should pull
  fomo           String?                // why the viewer should act now
  persona        String?                // who they're speaking to
  // Top-performing reference content — the "50 best videos" idea. URLs +
  // notes about why each works.
  examplesNotes  String?
  status         String   @default("active") // "active" | "archived"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments    BriefAssignment[]

  @@index([status])
}

// Many-to-many between Creator and Brief. Matt picks which briefs a creator
// is working on — stored here so it can change over time.
model BriefAssignment {
  id         String   @id @default(cuid())
  briefId    String
  creatorId  String
  assignedAt DateTime @default(now())

  brief      Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([briefId, creatorId])
  @@index([creatorId])
  @@index([briefId])
}

// One row per rate-limited request. Durable because Vercel runs each API route
// as a SEPARATE serverless instance — an in-memory counter in one is invisible
// to the others, so an attacker spreading requests across instances never trips
// the limit. (Same lesson as LookupLog: process memory is not shared state.)
//
// Rows are swept opportunistically on write; there's no need to keep them past
// the widest rate-limit window.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String   // "<bucket>:<ip>", e.g. "photo_upload:203.0.113"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// One row per bulk product edit applied from the /products view.
//
// Every batch stores the BEFORE value of each variant it touched, which is the
// whole point: a bulk price change is trivially easy to fire at a slightly
// wrong filter, and without the previous values a mistake means hand-fixing
// every affected variant in the Shopify admin. `changes` makes undo a
// mechanical replay rather than an archaeology project.
model ProductEditBatch {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  // Human summary shown in the batch list, e.g. "Set price to $100.00"
  description String
  // The filter state that produced the selection, kept for auditing
  filters     Json?
  // [{ variantId, productId, productTitle, size, frame, before, after }]
  changes     Json
  undoneAt    DateTime?
  // Who applied it, and who undid it. Null on batches from before sign-ins.
  actorId     String?
  actorEmail  String?
  undoneBy    String?

  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/**
 * A person who can sign in to TrackstarOS.
 *
 * Replaces the single shared ADMIN_PASSWORD. The shared password could not be
 * revoked for one person without rotating it for everyone, and it made every
 * action anonymous - with several contractors working in a tool that can
 * rewrite 116 live prices in one click, "who did this" needs an answer.
 *
 * Roles are deliberately only two. `admin` can do the irreversible things
 * (bulk price writes, variant deletion, cache and research wipes) and manage
 * users; `staff` can do everything else, which is the actual day to day work.
 * More roles can come when a real access difference appears, rather than
 * inventing a hierarchy nobody needs yet.
 */
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // Stored separately rather than as one "name" string. A single column forces
  // every reader to guess where the split is, and that guess is wrong for
  // anyone whose first or last name is more than one word.
  firstName    String
  lastName     String    @default("")
  // scrypt, stored as "scrypt:<saltHex>:<hashHex>". Null while an invite is
  // outstanding, which is also what blocks sign-in until they set one.
  passwordHash String?
  // admin | sales | fulfillment | designer (api/_lib/roles.js). "staff" from
  // before roles reads as designer.
  role         String    @default("designer")
  // Pay per custom design, in cents (USD), for the Custom Counter and the
  // month-end statement. Null = the level default (senior head designer
  // $50 / $25 repeat, junior designer $40 / $20). Set in Settings > Custom Counter.
  customRateCents       Int?
  customRepeatRateCents Int?
  isActive     Boolean   @default(true)
  // Bumped to sign this person out everywhere: on deactivation, a password
  // change or reset, or an admin's "Sign out everywhere". Carried in the
  // session cookie and compared on every request (api/_lib/auth.js).
  sessionVersion Int     @default(0)
  // Invite flow: a single-use token that lets someone set their first password.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  lastLoginAt  DateTime?
  // When they last used the app (throttled to every 5 minutes); see touchLastSeen.
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments     OrderComment[]
  assignedOrders Order[]  @relation("OrderAssignee")
  completedDesigns Order[] @relation("DesignCompletedBy")
  renderRequests   RenderJob[] @relation("RenderRequestedBy")
  renderReviews    RenderJob[] @relation("RenderReviewedBy")
  assignedBulkOrders BulkOrder[] @relation("BulkAssignee")
  editBatches  ProductEditBatch[]
  auditEvents  AuditEvent[]
  apiKeys      ApiKey[]
  supportThreads   SupportThread[]   @relation("SupportAssignee")
  supportReplies   SupportMessage[]  @relation("SupportSentBy")
  supportNotes     SupportNote[]     @relation("SupportNoteAuthor")
  supportReads     SupportRead[]
  supportMacros    SupportMacro[]    @relation("SupportMacroAuthor")

  @@index([email])
}

/**
 * Who did something consequential, and to what.
 *
 * Deliberately separate from the domain tables: an audit row must survive the
 * thing it describes being edited or deleted, so it stores plain text rather
 * than foreign keys to the affected record.
 */
model AuditEvent {
  id         String   @id @default(cuid())
  // "price.apply", "variant.delete", "research.clear", "user.invite", ...
  action     String
  // Human summary, e.g. "Set price to $100.00 on 116 variants".
  summary    String
  // Anything worth keeping: filters used, counts, affected ids.
  detail     Json?
  userId     String?
  // Denormalised so the row still names a person after a user is deleted.
  actorEmail String
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}

/**
 * Topline waitlist signups.
 *
 * This table was created outside Prisma and already exists in the database.
 * It is mapped here so `prisma db push` stops proposing to drop it - it is not
 * managed by this app, but silently deleting someone else's table is not a
 * migration, it is data loss.
 */
model ToplineWaitlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("topline_waitlist")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales. The seed of the CRM.
//
// Company is the organisation the deal is with (a race or a charity), and
// the deal's stage and cadence live on it. Contact is a person there.
// ─────────────────────────────────────────────────────────────────────────────
// Sales machinery. Attio holds the deal, the company, the person, the stage
// and the touch count. Postgres holds only what Attio cannot: the Gmail ids a
// follow-up needs to land in the same thread, the send log that says how many
// went out today, and a skip. Every
// row points at an Attio record id and nothing here is a fact about a deal.
// ─────────────────────────────────────────────────────────────────────────────

model SalesSend {
  id             String   @id @default(cuid())
  // Null for a one-off email to an address with no deal behind it.
  attioDealId    String?
  attioPersonId  String?
  toEmail        String
  touchNumber    Int
  angle          String?
  subject        String
  body           String
  attachments    String[] @default([])
  gmailMessageId String?
  gmailThreadId  String?
  // The RFC 5322 Message-ID we stamped on it, for In-Reply-To on the next touch.
  rfcMessageId   String?
  sentAt         DateTime @default(now())
  sentById       String?
  sentByEmail    String?
  // The write to Attio after the send: ok, or why not. Shown, never retried into a second send.
  attioOk        Boolean  @default(false)
  attioError     String?

  @@index([attioDealId, sentAt])
  @@index([sentAt])
}

// "Send later": an email a rep finished and set to go at a time, sent by the
// every-5-minutes cron (api/sales/send-due.js) through that rep's Gmail. Queue
// machinery only: the deal and person are Attio ids. Status runs
// scheduled -> sending -> sent, or held (with why) when the deal moved or
// the send failed, or cancelled.
model SalesScheduled {
  id             String    @id @default(cuid())
  // Null for a one-off to an address with no deal behind it.
  attioDealId    String?
  attioPersonId  String?
  toEmail        String
  adhoc          Boolean   @default(false)
  // The touch this was written as. If Attio's count moved by send time, it is held.
  touchNumber    Int?
  subject        String
  body           String
  assetIds       String[]  @default([])
  sendAt         DateTime
  status         String    @default("scheduled")
  error          String?
  createdById    String
  createdByEmail String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  salesSendId    String?

  @@index([status, sendAt])
  @@index([createdById, status])
}

// "Skip today": hidden from the queue until `until`. The reason is for tomorrow's person.
model SalesSkip {
  attioDealId String   @id
  until       DateTime
  reason      String?
  byEmail     String?
  createdAt   DateTime @default(now())
}

// A credential for reaching the tool from outside: the MCP server (Claude on
// a phone, the nightly routine) and anything else that integrates. The
// secret is shown once and only its hash is kept. A key acts as a person
// (userId) and can do no more than that person's role allows, narrowed
// further by its scopes; a key with no person is a service key for a
// routine and can only read or repair. Revoked keys are kept for the record.
model ApiKey {
  id          String    @id @default(cuid())
  name        String                 // "Matt's phone", "Nightly sweep"
  prefix      String                 // First characters of the secret, to tell keys apart
  hash        String    @unique      // sha256 of the secret
  scopes      String[]               // read | write | admin | repair
  userId      String?
  createdById String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Design Survey: community votes on new design options (Instagram story link).
// Built on the proof portal's upload path, but nobody approves anything: each
// visitor picks one option and can say why.
model DesignSurvey {
  id          String         @id @default(cuid())
  token       String         @unique // the public link, /vote/{token}
  title       String         // e.g. "Chicago Marathon 2026"
  question    String?        // shown above the options; a default is used when empty
  status      String         @default("open") // "open" | "closed"
  // When voting stops. Null means no limit. After this the public page says
  // the survey has ended and refuses votes, without anyone closing it.
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  options     SurveyOption[]
  votes       SurveyVote[]
}

model SurveyOption {
  id           String       @id @default(cuid())
  surveyId     String
  survey       DesignSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  label        String?      // optional name; voters see "Option 1", "Option 2" otherwise
  imageUrl     String
  thumbnailUrl String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  votes        SurveyVote[]

  @@index([surveyId])
}

model SurveyVote {
  id        String       @id @default(cuid())
  surveyId  String
  survey    DesignSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  optionId  String
  option    SurveyOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterId   String       // random id kept in the voter's browser; one vote each, changeable
  comment   String?
  ipHash    String?      // salted hash, only to spot ballot stuffing; never the raw address
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([surveyId, voterId])
  @@index([optionId])
}

/**
 * Automated print rendering. A job asks a render worker (a script on a Mac
 * with Illustrator, worker/render-worker.mjs) to fill the race's production
 * template with one order's details and export the print file. The worker
 * polls for queued jobs, so the tool never needs to reach the Mac.
 *
 * Files land in the private "production-files" bucket as
 * renders/<orderId>/v<version>.pdf and .png. Nothing is overwritten; a
 * re-render is a new version. A person reviews every render before it goes
 * anywhere (review: pending | approved | rejected).
 */
model RenderJob {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version       Int       @default(1)
  // queued | rendering | done | failed
  status        String    @default("queued")
  // admin | system | customer: who asked, so customer-facing proofs can share this later
  requestedBy   String    @default("admin")
  requestedById String?
  requester     User?     @relation("RenderRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  // The exact values the worker rendered, kept so a review compares against what was sent
  spec          Json
  workerId      String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  pdfPath       String?
  previewPath   String?
  notes         String?   // what the worker did beyond the plain fill, e.g. "name shrunk 1 step"
  error         String?
  // pending | approved | rejected
  review        String    @default("pending")
  reviewNote    String?
  reviewedById  String?
  reviewer      User?     @relation("RenderReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  // An approved render is uploaded to the shop's Drive Orders folder, the
  // same place a designer saves by hand (server/domain/render/deliver.js).
  deliveredAt   DateTime?
  deliveredPath String?   // the Drive link
  // The same PDF in the Artelo image library (server/domain/render/artelo.js)
  arteloUploadId   String?
  arteloUrl        String?
  arteloUploadedAt DateTime?
  arteloError      String?
  // Approve sends the print to production (server/domain/render/arteloSend.js):
  // it waits until sendAfter (a few minutes, so a wrong click can be held),
  // then is attached to its Artelo order item and the order is sent.
  // sendError is why Artelo would not take it; sendAfter is then the next try, or null.
  sendAfter        DateTime?
  sendHeldAt       DateTime?
  sendHeldBy       String?
  arteloItemId     String?
  arteloAttachedAt DateTime?
  arteloSentAt     DateTime?
  sendError        String?
  sendCheckedAt    DateTime?
  deliveryError String?
  // Set when the race's date or weather changed after this render was made: it needs re-rendering.
  staleReason   String?
  // What the worker measured in the PDF it made: { trimIn, bleedIn: {left,right,top,bottom}, color } (worker/lib/inspectPdf.mjs)
  output        Json?
  createdAt     DateTime  @default(now())

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([sendAfter])
}

/** A render worker that has checked in. Online means seen in the last minute. */
model RenderWorker {
  id         String   @id
  name       String
  // Template keys this worker can render right now (file present, check passed)
  templates  Json
  // Per template key: { present, mtime } as the worker last saw the file on its disk
  files      Json?
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
}

/**
 * A production file the renderer fills: one per race design, keyed by the
 * race's name as the tool knows it, plus " / <edition>" for an alternate
 * design sold as its own product (World Majors). Races span years, so this
 * hangs off the race name, not a Race row. The file path is relative to the
 * shop's Drive Races folder, which every worker has synced.
 *
 * A template is usable only when enabled, its last check passed, and a
 * worker that is online has the file. Workers run the check themselves
 * whenever the file changes (worker/illustrator/check.jsx) and report here.
 */
model PrintTemplate {
  id              String    @id @default(cuid())
  key             String    @unique
  raceName        String
  edition         String?
  file            String
  // A file uploaded in the tool (a co-branded bulk design) instead of one in
  // the Drive Races folder: its path in the private print-templates bucket,
  // and when it was uploaded. The worker downloads it (render-worker.mjs).
  storagePath     String?
  fileVersion     String?
  // { artboard, artboardExclude, photoArtboard }: how to pick the artboard, see worker/README.md
  rules           Json?
  enabled         Boolean   @default(true)
  notes           String?
  lastCheckAt     DateTime?
  lastCheckOk     Boolean?
  // The checker's findings: { problems: [], warnings: [], sizes: { "12x18": {...} } }
  lastCheckReport Json?
  lastCheckMtime  String?   // the file's modification time the check was run against
  lastCheckWorker String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([raceName])
}

/**
 * Settings > Design Needs: what the designer has to fix in a production file
 * so the render script can make a print (server/domain/render/designNeeds.js).
 * Found by the tool from the orders it is stuck on (source auto), added when
 * a design is rejected for a file problem (reject), or written by a person
 * (manual). Checked off by whoever fixed it.
 */
model DesignNeed {
  id            String    @id @default(cuid())
  // What it is, so the tool finds an auto need again: "notime|<template>|<size>", "reject|<jobId>"...
  key           String    @unique
  // production_file | no_time_layer | photo_window | file_problem | rejected | other
  kind          String
  title         String
  template      String?
  size          String?
  detail        String?
  // The orders waiting on it: [{ id, number }]
  orders        Json?
  source        String    // auto | reject | manual
  status        String    @default("open") // open | done
  // The latest word on it: how it closed, or why it reopened.
  note          String?
  renderJobId   String?
  createdById   String?
  createdByName String?
  doneAt        DateTime?
  doneById      String?
  doneByName    String?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

/**
 * Settings > Feature Requests: things the team asks to have built, sent from
 * the Request feature button in Support (or added in Settings). Anyone signed
 * in adds and reads them; an admin marks them done when they ship
 * (server/domain/featureRequests.js).
 */
model FeatureRequest {
  id            String    @id @default(cuid())
  title         String
  detail        String?
  // Where it was asked from ("support", "settings")
  source        String    @default("settings")
  status        String    @default("open") // open | done
  // How it was resolved, or why it will not be built
  note          String?
  createdById   String?
  createdByName String?
  doneAt        DateTime?
  doneByName    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// -----------------------------------------------------------------------------
// Support: the shared inbox for fast@trackstar.art
// -----------------------------------------------------------------------------
// Gmail is the system of record for the mail itself, the way Attio is for
// deals. These tables are the mirror the page reads from, so a rep never
// waits on Gmail to list the inbox, plus the machinery Gmail has no idea of:
// who has the thread, whether it is waiting on the customer, when it was
// snoozed to. A thread is one Gmail thread; a message is one Gmail message,
// stored once by its Gmail id so a re-sync cannot duplicate it.
//
// Status, and who moves it:
//   open      the customer is waiting on us. Set by the sync when an inbound
//             message arrives, on a new thread or a thread in any other state.
//   waiting   we are waiting on the customer. Set by the sync when a message
//             goes out from the mailbox, whether sent from here or in Gmail.
//   escalated a person pulled Matt in. Only a person sets it; a reply does
//             not clear it, an inbound message does not either.
//   closed    done. A person closes it; a new inbound message reopens it.
model SupportThread {
  id              String    @id @default(cuid())
  // "email" is a Gmail thread in fast@; "instagram" is a DM conversation with
  // one customer. One of the ids below is set, by channel.
  channel         String    @default("email")
  gmailThreadId   String?   @unique
  // Instagram: the customer's Instagram-scoped id (one thread per customer,
  // reopened when they write again), the conversation id once the API has
  // told us, and the handle to reply to and show.
  igUserId        String?   @unique
  igConversationId String?  @unique
  igUsername      String    @default("")
  subject         String    @default("")
  // The other party: the address that is not the mailbox. One per thread;
  // a thread with several correspondents keeps the first.
  customerEmail   String    @default("")
  customerName    String    @default("")
  status          String    @default("open")
  snoozedUntil    DateTime?
  assigneeId      String?
  assignee        User?     @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Starred, the way Intercom marks a priority conversation. A person sets it.
  priority        Boolean   @default(false)
  // Free-form labels; the playbook's scenario names are offered as suggestions.
  tags            String[]  @default([])
  // From a sender the team filtered out (vendors, alerts, newsletters): kept,
  // never in the inbox views, findable under Filtered. See support/filters.js.
  filtered        Boolean   @default(false)
  // Folded into another conversation (the customer wrote again instead of
  // replying). Its messages moved there; the row stays so mail that still
  // arrives on this Gmail thread lands in the merged conversation.
  mergedIntoId    String?
  // The newest message's first line, for the list.
  snippet         String    @default("")
  messageCount    Int       @default(0)
  lastMessageAt   DateTime  @default(now())
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  // Set by the backfill for threads that were already over when the mirror
  // was built, so a report can tell history from live work.
  backfilled      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages        SupportMessage[]
  notes           SupportNote[]
  reads           SupportRead[]

  @@index([status, lastMessageAt])
  @@index([filtered, status])
  @@index([mergedIntoId])
  @@index([assigneeId, status])
  @@index([customerEmail])
  @@index([lastMessageAt])
  @@index([channel, status])
}

// An order a teammate attached to a customer by hand, because they wrote in
// from a different email than the one on the order. Keyed by the customer,
// not the conversation, so every conversation with them (now and later) shows
// it. customerKey is the lowercased email, or "ig:<igUserId>" for an
// Instagram customer with no email.
model SupportLinkedOrder {
  id           String   @id @default(cuid())
  customerKey  String
  // The number a person reads, without "#": "4517" (Shopify) or an Etsy receipt.
  orderNumber  String
  // The email on the order, for reference: the address they actually bought under.
  orderEmail   String   @default("")
  linkedById   String?
  linkedByName String   @default("")
  createdAt    DateTime @default(now())

  @@unique([customerKey, orderNumber])
  @@index([customerKey])
}

model SupportMessage {
  id              String    @id @default(cuid())
  threadId        String
  thread          SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // Same as the thread's. The message is stored once, by the channel's own id.
  channel         String    @default("email")
  gmailMessageId  String?   @unique
  igMessageId     String?   @unique
  // The RFC 822 Message-ID and the one it answers, so a reply from here can
  // thread correctly in the customer's mail client, not only in Gmail.
  rfcMessageId    String?
  inReplyTo       String?
  // "in" from the customer, "out" from the mailbox.
  direction       String
  fromEmail       String    @default("")
  fromName        String    @default("")
  toEmails        String    @default("")
  ccEmails        String    @default("")
  subject         String    @default("")
  bodyText        String    @default("")
  bodyHtml        String?
  // [{ filename, mimeType, size, attachmentId }]. The bytes stay in Gmail.
  attachments     Json?
  sentAt          DateTime
  // Who pressed Send here. Null for inbound mail, for anything sent in Gmail
  // itself, and for everything the backfill found.
  sentById        String?
  sentBy          User?     @relation("SupportSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([threadId, sentAt])
  @@index([sentAt])
  // Last import time on the Support page (mailbox status()).
  @@index([channel, createdAt])
}

// What the team says to each other on a thread, and what happened to it.
// A note is internal, never sent, and can @mention teammates (their ids in
// `mentions`), which is what the Mentions view lists. An event is the
// system's line in the same timeline: assigned, closed, snoozed, starred.
// Later, Claude's draft and investigation land here as a note too.
model SupportNote {
  id         String   @id @default(cuid())
  threadId   String
  thread     SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  kind       String   @default("note") // note | event | draft
  // A draft's working: scenario, key facts, steps, suggested actions, escalation. Null on notes and events.
  data       Json?
  body       String
  authorId   String?
  author     User?    @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String   @default("")
  mentions   String[] @default([])
  createdAt  DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([mentions])
}

// When each person last opened a thread, so the list can show unread the
// way a mail client does: bold until you have seen the newest message.
model SupportRead {
  threadId String
  thread   SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime      @default(now())

  @@id([threadId, userId])
  @@index([userId])
}

// Saved replies, Intercom's "macros". The playbook's templates are seeded in
// once; after that the team edits them here. {{first_name}} and {{rep}} are
// filled when one is inserted; anything in [brackets] is left for the rep.
// Every saved version of the support playbook (support/playbook.js): an
// edit in Settings, a lesson taught from a draft, a reset, or the weekly
// review (support/playbookReview.js), so any change can be undone.
model SupportPlaybookVersion {
  id          String   @id @default(cuid())
  text        String
  source      String   // edit | lesson | reset | weekly | restore
  summary     String?  // What changed and why (the weekly review's changelog)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model SupportMacro {
  id          String   @id @default(cuid())
  name        String
  // Typed after a slash in the reply to insert it: /shipped. Letters, digits and dashes.
  shortcut    String?
  body        String
  createdById String?
  createdBy   User?    @relation("SupportMacroAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  uses        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([shortcut])
}

// An ad that is working, shown to the team in /creators and to creators in
// their portal so everyone can see what to make more of. Link-based: the
// video lives wherever it already is (Meta ad library, Instagram, Drive).
model WinningAd {
  id          String   @id @default(cuid())
  title       String
  url         String
  imageUrl    String?
  notes       String?  // why it works, the hook, the numbers
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// What a sample cost us, recorded when it is sent: from Tools > Samples, the
// MCP's send_sample, or a creator's sample. Money in integer cents.
// cost is Artelo production + shipping + branding at the time it was sent;
// charged is what the recipient paid (at-cost samples), so cost - charged is
// what the sample really cost. The monthly sample spend reads this table.
model SampleCost {
  id           String   @id @default(cuid())
  source       String   // "samples_tool" | "mcp" | "creator"
  orderName    String?  // Shopify order name (#5321) or CREATOR-XXXXXX
  recipient    String
  email        String?
  items        Json     // [{ title, size, frame, quantity }]
  costCents    Int
  chargedCents Int      @default(0)
  creatorId    String?  // set for a creator's sample
  currency     String   @default("USD")
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/**
 * A page fetch the server cannot make itself, handed to the render worker on
 * Matt's Mac. Some timing sites sit behind Cloudflare rules that refuse cloud
 * addresses (TrueTime answers Vercel with 403) but serve a home connection
 * fine. The server queues the request here, the worker fetches it and posts
 * the page back, and the lookup carries on. Only hosts in
 * server/lib/fetchRelay.js RELAY_HOSTS; rows are short-lived (a day at most).
 */
model FetchRelay {
  id             String    @id @default(cuid())
  url            String
  method         String    @default("GET")
  headers        Json?
  body           String?
  // pending | claimed | done | failed | expired
  status         String    @default("pending")
  workerId       String?
  claimedAt      DateTime?
  responseStatus Int?
  responseBody   String?
  setCookies     Json?
  error          String?
  createdAt      DateTime  @default(now())
  doneAt         DateTime?

  @@index([status, createdAt])
}

// Settings > Site Gallery: an approved custom design offered for the "Our
// Favorite Designs" section on the custom product page. A row exists once a
// designer stars it or an admin decides; an approved custom with no row is
// simply a suggestion (server/domain/gallery/siteGallery.js).
model GalleryPick {
  id            String    @id @default(cuid())
  orderId       String    @unique
  status        String    @default("suggested") // "suggested" | "live" | "skipped"
  segment       String?   // "marathon" | "ultra" | "other"; null = guessed from the race
  starredById   String?
  starredAt     DateTime?
  decidedById   String?
  decidedAt     DateTime?
  // The Shopify metaobject entry (type custom_gallery_item) while it is live.
  metaobjectId  String?
  shopifyFileId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}
