# Render worker settings. Copy to worker/.env on the Mac that runs Illustrator.
FULFILLMENT_URL=https://fast.trackstar.art
# An API key with the worker scope, from Settings > Admin > API Keys
# (a person's write key still works, but a worker key can do nothing else)
RENDER_API_KEY=
# The synced Google Drive folder with one subfolder per race
RACES_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/3_Trackstar/Product/Races
# How this machine appears in the tool
WORKER_NAME=Matt's MacBook
# Illustrator PDF preset to export with
PDF_PRESET=TRACKSTAR DEFAULT
# Timing sites that refuse cloud addresses: the tool asks this Mac to fetch
# them. Comma list of hosts; only these, and redirects only among them.
# RELAY_HOSTS=results.truetimeracing.com
# Only for worker/render-local.mjs (rendering past orders to check a template),
# which reads them from the repo's own env file (dotenv: .env in the folder it runs from):
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL
