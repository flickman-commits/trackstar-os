{% comment %}
  Trackstar order confirmation, the top of the email. Everything from the
  first line of the template down to (not including) Shopify's
  <table class="row section"> that starts the Order summary. Shopify's own
  order summary and customer information blocks stay as they are; the
  <style> below restyles them. See README.md for where this goes.

  KEEP_THE_EXISTING_SECRET: the hmac_sha256 argument below is the store's
  link-signing secret. It is not in this repo; paste in the value the live
  template already has on its hmac_sha256 line.
{% endcomment %}
{% assign is_custom_order = false %}
{% assign has_preorder = false %}
{% assign preorder_note = '' %}
{% for line_item in line_items %}
  {% if line_item.product_id == 10068385759515 %}
    {% assign is_custom_order = true %}
  {% endif %}
  {% for prop in line_item.properties %}
    {% if prop.first == 'Pre-order' and prop.last != blank %}
      {% assign has_preorder = true %}
      {% assign preorder_note = prop.last %}
    {% endif %}
  {% endfor %}
{% endfor %}

{% assign delivery_method_types = delivery_agreements | map: 'delivery_method_type' | uniq %}
{% if delivery_method_types.size > 1 %}
  {% assign has_split_cart = true %}
{% else %}
  {% assign has_split_cart = false %}
{% endif %}

{% assign ship_order_id = order.id | append: '' %}
{% comment %} PASTE THE SECRET between the quotes on the next line (the value your old template had on its hmac_sha256 line). Until it is pasted, the Manage your order button stays hidden rather than sending a link that cannot work. {% endcomment %}
{% assign link_secret = 'KEEP_THE_EXISTING_SECRET' %}
{% assign ship_sig = ship_order_id | hmac_sha256: link_secret %}
{% assign can_manage = false %}
{% if requires_shipping and has_pending_payment != true and delivery_method != 'pick-up' and link_secret != 'KEEP_THE_EXISTING_SECRET' %}
  {% assign can_manage = true %}
{% endif %}
{% assign two_weeks_seconds = 1209600 %}
{% assign mockup_date = created_at | date: "%s" | plus: two_weeks_seconds | date: "%B %-d" %}

{% capture email_title %}
  {% if has_pending_payment %}
    Thank you for your order
  {% else %}
    Your order is in
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="en">
  <head>
  <title>{{ email_title | strip }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');

    /* Trackstar: Inter (Helvetica behind it), -0.04em tracking, ink on white. */
    body, .body, table, td, p, h1, h2, h3, h4, a, span, dt, dd, .button__text {
      font-family: Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
      letter-spacing: -0.04em !important;
    }
    /* Off-white page, one white card for the news, ink footer: the site's panel system. */
    body, .body { background-color: #F6F5F2 !important; color: #1A1A1A !important; }
    .body > tbody > tr > td { background-color: #F6F5F2 !important; }
    .container { width: 560px; max-width: 100%; }
    /* Shopify inlines this sheet and sets border-collapse: collapse on every table, which squares off bordered cells in Apple Mail. */
    .ts-round { border-collapse: separate !important; }
    a, a:hover, a:active, a:visited { color: #4600D6 !important; }

    /* Shopify's own blocks, restyled. */
    .header__cell, .content__cell, .section__cell, .footer__cell { padding: 0 !important; background: transparent !important; border: 0 !important; }
    .row.section { border-top: 0 !important; }
    /* Shopify's summary and customer blocks sit on the page, not in the card.
       Inset them by the card's own padding so every left and right edge lines
       up, top to bottom. Subtotals start at the left edge too, not halfway in. */
    .section__cell > center > .container > tbody > tr > td, .section__cell > center > .container > tr > td { padding-left: 44px !important; padding-right: 44px !important; }
    /* Shopify nests a container inside the section's; only the outer one is inset. */
    .container .container > tbody > tr > td, .container .container > tr > td { padding-left: 0 !important; padding-right: 0 !important; }
    .subtotal-spacer { width: 0 !important; padding: 0 !important; }
    .subtotal-table { width: 100% !important; }
    h3 { font-size: 20px !important; font-weight: 700 !important; color: #1A1A1A !important; margin: 36px 0 12px !important; line-height: 1.15 !important; }
    h4 { font-size: 14px !important; font-weight: 500 !important; color: #666666 !important; margin: 0 0 4px !important; }
    .order-list__item { border-bottom: 1px solid #E0E0E0 !important; }
    /* Shopify adds a rule before each delivery group (Shipping items, Pickup in store items) right under the last item's own rule, which drew two lines. One is enough. */
    .order-list__delivery-method-type-separator { display: none !important; }
    .order-list__delivery-method-type { margin: 22px 0 6px !important; }
    .order-list__item__cell { padding: 6px 0 14px !important; }
    .order-list__product-description-cell { padding-left: 14px !important; }
    .order-list__item-title { font-size: 16px !important; font-weight: 700 !important; color: #1A1A1A !important; line-height: 1.3 !important; }
    .order-list__item-variant, .order-list__item-discount-allocation { font-size: 14px !important; color: #666666 !important; }
    .order-list__item-price { font-size: 16px !important; font-weight: 700 !important; color: #1A1A1A !important; }
    .order-list__item-original-price { font-size: 14px !important; color: #666666 !important; }
    .order-list__product-image { border-radius: 4px !important; border: 1px solid #E0E0E0 !important; }
    .subtotal-line__title p, .subtotal-line__title span { font-size: 15px !important; color: #666666 !important; }
    .subtotal-line__value strong { font-size: 15px !important; font-weight: 500 !important; color: #1A1A1A !important; }
    .subtotal-table--total .subtotal-line__title span { color: #1A1A1A !important; font-weight: 700 !important; font-size: 18px !important; }
    .subtotal-table--total .subtotal-line__value strong { font-weight: 700 !important; font-size: 18px !important; }
    .total-discount { color: #2E7D5B !important; font-size: 14px !important; }
    .customer-info__item { padding: 12px 0 !important; }
    .customer-info__item p, .customer-info__item-content { font-size: 15px !important; color: #1A1A1A !important; line-height: 1.4 !important; }
    .disclaimer__subtext { display: none !important; }


    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      /* Bigger type on phones. A lot of buyers are reading this on a small screen. */
      .ts-f12 { font-size: 14px !important; }
      .ts-f13, .ts-f14 { font-size: 16px !important; }
      .ts-f15, .ts-f16 { font-size: 18px !important; line-height: 1.4 !important; }
      .ts-f22 { font-size: 26px !important; }
      .ts-chip { font-size: 14px !important; }
      .ts-h1 { font-size: 40px !important; line-height: 1.02 !important; }
      .ts-mock { width: 72px !important; }
      .ts-photo-cell { width: 72px !important; }
      .ts-mock-img { width: 72px !important; }
      .ts-btn-a { font-size: 18px !important; padding: 18px 32px !important; }
      .order-list__item-title { font-size: 18px !important; }
      /* Smaller thumbnails so a line item fits a phone beside its price. */
      .order-list__image-cell, .order-list__image-cell > * { width: 52px !important; }
      .order-list__product-image { width: 48px !important; height: auto !important; }
      .order-list__product-description-cell { padding-left: 10px !important; }
      .order-list__item-variant, .order-list__item-discount-allocation, .order-list__item-original-price { font-size: 16px !important; }
      .order-list__item-price { font-size: 18px !important; }
      .subtotal-line__title p, .subtotal-line__title span, .subtotal-line__value strong { font-size: 17px !important; }
      .subtotal-table--total .subtotal-line__title span, .subtotal-table--total .subtotal-line__value strong { font-size: 20px !important; }
      .customer-info__item p, .customer-info__item-content { font-size: 17px !important; }
      /* One column of customer details on a phone. */
      .customer-info__item { display: block !important; width: 100% !important; }
      h3 { font-size: 24px !important; }
      h4 { font-size: 16px !important; }
      .ts-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .ts-outer { padding-left: 12px !important; padding-right: 12px !important; }
      .ts-card-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .ts-hero { padding-top: 40px !important; padding-left: 12px !important; padding-right: 12px !important; }
      .ts-hero-gap { height: 40px !important; line-height: 40px !important; }
      .section__cell > center > .container > tbody > tr > td, .section__cell > center > .container > tr > td { padding-left: 32px !important; padding-right: 32px !important; }
      .ts-in { padding-left: 0 !important; padding-right: 0 !important; }
      .ts-btn2 { display: block !important; width: 100% !important; padding: 0 0 10px !important; }
      .ts-btn2 a { display: block !important; text-align: center !important; }
      .ts-btn { display: block !important; width: 100% !important; }
      .ts-btn a { display: block !important; text-align: center !important; }
      .ts-photo { width: 72px !important; height: 72px !important; }
    }
  </style>
</head>

  <body>
    <table class="body">
      <tr>
        <td>
          <center>
          <table class="container" cellpadding="0" cellspacing="0">
            {% comment %}
              The photo sits behind the top of the card: the home page's runner
              photo with the white wordmark and slogan over it, and the white
              card starts on top of it (the card's top half is drawn inside the
              photo cell, the rest continues below on the page, so they read as
              one card). The photo fades into the page colour at the bottom.
              Clients that drop background images (Outlook on Windows) show
              ink behind it instead, so the white type still reads.
            {% endcomment %}
            <tr><td class="ts-hero" background="https://fast.trackstar.art/email/order-hero.jpg" bgcolor="#1A1A1A" style="background-color: #1A1A1A; background-image: url('https://fast.trackstar.art/email/order-hero.jpg'); background-image: linear-gradient(rgba(26,26,26,0.55), rgba(26,26,26,0) 45%, rgba(246,245,242,0) 70%, #F6F5F2 100%), url('https://fast.trackstar.art/email/order-hero.jpg'); background-size: cover; background-position: center center; padding: 52px 16px 0; text-align: center;">
              <a href="{{ shop.url }}"><img src="https://www.trackstar.art/cdn/shop/files/Trackstar_White_Logo_Cropped.png" alt="Trackstar" width="150" style="display: inline-block; width: 150px; height: auto; border: 0;"></a>
              <p class="ts-f14" style="margin: 8px 0 0; font-size: 14px; color: #FFFFFF;">Celebrating athletic achievement.</p>
              <div class="ts-hero-gap" style="height: 52px; line-height: 52px; font-size: 1px;">&nbsp;</div>
              <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; background-color: #FFFFFF; border-radius: 18px 18px 0 0;"><tr>
                <td class="ts-card-pad" style="padding: 24px 28px 0; text-align: left;">
                  <table width="100%" cellpadding="0" cellspacing="0"><tr>
                    <td style="vertical-align: middle;">
                      <span class="ts-f13" style="display: inline-block; padding: 6px 12px; border: 1px solid #E0E0E0; border-radius: 999px; font-size: 13px; font-weight: 700; color: #1A1A1A; white-space: nowrap;"><span style="color: {% if has_pending_payment %}#F28C28{% else %}#2E7D5B{% endif %};">&#9679;</span>&nbsp; {% if has_pending_payment %}Payment pending{% else %}Order confirmed{% endif %}</span>
                    </td>
                    <td style="vertical-align: middle; text-align: right;">
                      <span class="ts-f13" style="display: inline-block; padding: 6px 12px; border: 1px solid #E0E0E0; border-radius: 999px; font-size: 13px; font-weight: 700; color: #1A1A1A; white-space: nowrap;">Order {{ order_name }}</span>
                    </td>
                  </tr></table>
                </td>
              </tr></table>
            </td></tr>

            {% comment %} The rest of the card, on the page. {% endcomment %}
            <tr><td class="ts-outer" style="padding: 0 16px;">
            <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; background-color: #FFFFFF; border-radius: 0 0 18px 18px;">
            <tr><td class="ts-card-pad" style="padding: 24px 28px 30px;">
            <table width="100%" cellpadding="0" cellspacing="0">

            <tr><td class="ts-in" style="padding: 0 0 8px;">
              <h1 class="ts-h1" style="margin: 0 0 14px; font-size: 40px; font-weight: 700; line-height: 1.02; color: #1A1A1A;">{% if customer.first_name %}Thank you,<br><span style="color: #4600D6;">{{ customer.first_name }}.</span>{% else %}Thank you<br><span style="color: #4600D6;">for your order.</span>{% endif %}</h1>
              <p class="ts-f16" style="margin: 0 0 8px; font-size: 16px; line-height: 1.4; color: #1A1A1A;">
                {% if has_pending_payment %}
                  {% if buyer_action_required %}
                    You'll get a confirmation email once your payment goes through.
                  {% else %}
                    Your payment is being processed, and you'll get an email when your order is confirmed.
                  {% endif %}
                {% elsif is_custom_order %}
                  We're excited to draw your custom print. Our team reviews the race details you sent and starts on the design, and you'll see a mockup to approve before anything prints.
                {% elsif has_preorder %}
                  The race hasn't happened yet, so your print waits for race day. Once the official results are posted we add the finish time, pace and bib, then print it.
                {% else %}
                  We've got everything we need. Here's what happens from here.
                {% endif %}
              </p>
            </td></tr>

            {% if is_custom_order and has_pending_payment != true %}
            {% comment %} Custom orders hinge on one email we send later: the mockup to approve. It comes from the support mailbox, which a new contact's inbox may file as spam. {% endcomment %}
            <tr><td class="ts-in" style="padding: 12px 0 4px;">
              <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate;"><tr>
                <td class="ts-f13" style="padding: 12px 16px; background-color: #FEF4E6; border: 1px solid #F6D9B0; border-radius: 8px; font-size: 13px; line-height: 1.45; color: #1A1A1A;">
                  <strong class="ts-f16" style="display: block; margin: 0 0 4px; font-size: 16px; font-weight: 700; color: #A8510C;">Don't miss your mockup</strong>
                  Your mockup and approval link will be emailed to you from <a href="mailto:fast@trackstar.art" style="color: #1A1A1A !important; font-weight: 700; text-decoration: none;">fast@trackstar.art</a>. Please add that address to your contacts now so it lands in your inbox, not spam. On iPhone, tap the address and choose Add to VIPs.
                </td>
              </tr></table>
            </td></tr>
            {% endif %}

            {% unless has_pending_payment %}
            {% comment %} What happens next. Purple numbers on white, the only purple fill on the page. {% endcomment %}
            <tr><td class="ts-in" style="padding: 16px 0 8px;">
              <table cellpadding="0" cellspacing="0" style="border-collapse: collapse;">
                {% assign whose = 'your' %}
                {% for line in line_items %}{% for prop in line.properties %}{% if prop.first == 'Gift' and prop.last != blank %}{% assign whose = "your runner's" %}{% endif %}{% endfor %}{% endfor %}
                {% if is_custom_order %}
                  {% assign steps = 'Today~Order confirmed|Before ' | append: mockup_date | append: '~You’ll receive design options from our team via email|On your approval~We print, frame & ship your order|7 to 10 days after approval~Delivered to ' | append: whose | append: ' doorstep' | split: '|' %}
                {% elsif has_preorder %}
                  {% assign race_day = preorder_note | remove: 'Ships after race day, ' | strip %}
                  {% assign steps = 'Today~Order confirmed|Until race day~Change the name, frame or address any time before the race|' | append: race_day | append: '~After race day, we add the official results and send your print to production|Next 7 days~Printed, framed and shipped from Kentucky|10 to 12 days after race day~Delivered to ' | append: whose | append: ' doorstep' | split: '|' %}
                {% else %}
                  {% assign steps = 'Today~Order confirmed|First 48 hrs after ordering~You can make changes to your order (name, frame, size & address). After that, we send it to production|~We print, frame & ship your order|10 to 12 days after ordering~Delivered to ' | append: whose | append: ' doorstep' | split: '|' %}
                {% endif %}
                {% for step in steps %}
                <tr>
                  <td style="width: 28px; padding: 0; vertical-align: top;">
                    <table cellpadding="0" cellspacing="0" style="border-collapse: collapse;"><tr>
                      <td class="ts-f14" style="width: 28px; height: 28px; border-radius: 999px; background-color: #4600D6; color: #FFFFFF; font-size: 14px; font-weight: 700; text-align: center; vertical-align: middle; line-height: 28px;">{{ forloop.index }}</td>
                    </tr>
                    {% unless forloop.last %}
                    <tr><td style="padding: 3px 0 3px 13px;"><div style="width: 2px; height: 16px; background-color: #E0E0E0;"></div></td></tr>
                    {% endunless %}
                    </table>
                  </td>
                  {% assign parts = step | split: '~' %}
                  <td style="padding: 0 0 0 14px; vertical-align: top;">
                    {% comment %} What happens reads first, beside its number; when it happens sits under it. {% endcomment %}
                    <div class="ts-f16" style="padding: 4px 0 {% if parts[0] == blank %}10px{% else %}2px{% endif %}; font-size: 16px; line-height: 1.3; color: #1A1A1A;{% if forloop.first %} font-weight: 700;{% endif %}">{{ parts[1] }}</div>
                    {% if parts[0] != blank %}<span class="ts-f12" style="display: inline-block; margin: 0 0 8px; padding: 1px 8px; border-radius: 999px; background-color: #F6F5F2; font-size: 12px; font-weight: 700; line-height: 1.4; color: #4600D6;">{{ parts[0] }}</span>{% endif %}
                  </td>
                </tr>
                {% endfor %}
              </table>
            </td></tr>
            {% endunless %}

            {% comment %} The prints: the details that will be on them, from the order's line item properties. {% endcomment %}
            {% for line in line_items %}
              {% assign is_addon = false %}
              {% assign p_runner = '' %}{% assign p_year = '' %}{% assign p_event = '' %}{% assign p_bib = '' %}{% assign p_time = '' %}{% assign p_pace = '' %}{% assign p_notime = '' %}{% assign p_gift = '' %}{% assign p_preorder = '' %}{% assign p_photo = '' %}{% assign p_photo_later = '' %}{% assign p_outcome = '' %}{% assign p_addon_for = '' %}
              {% for prop in line.properties %}
                {% assign k = prop.first | strip %}{% assign v = prop.last | strip %}
                {% if k contains 'Runner Name' %}{% assign p_runner = v %}
                {% elsif k == 'Race Year' %}{% assign p_year = v %}
                {% elsif k == 'Event' %}{% assign p_event = v %}
                {% elsif k contains 'Bib' %}{% assign p_bib = v %}
                {% elsif k == 'Time' %}{% assign p_time = v %}
                {% elsif k == 'Pace' %}{% assign p_pace = v %}
                {% elsif k == 'No Time' %}{% assign p_notime = v %}
                {% elsif k == 'Gift' %}{% assign p_gift = v %}
                {% elsif k == 'Pre-order' %}{% assign p_preorder = v %}
                {% elsif k == '_photo_path' %}{% assign p_photo = v %}
                {% elsif k == '_photo_later' %}{% assign p_photo_later = v %}
                {% elsif k == '_lookup_outcome' %}{% assign p_outcome = v %}
                {% elsif k == '_addon_for' %}{% assign p_addon_for = v %}
                {% endif %}
              {% endfor %}
              {% if p_addon_for != blank or line.title contains 'Photo Add-On' or line.gift_card %}{% assign is_addon = true %}{% endif %}
              {% assign runner = p_runner %}
              {% if is_addon == false and runner != blank %}
              {% assign print_photo = p_photo %}
              {% assign photo_later = p_photo_later %}
              {% assign outcome = p_outcome %}
              {% comment %} In order emails line.title carries the variant ("... - 12x18 / Natural Oak"); the product's own title does not. {% endcomment %}
              {% assign race_title = line.product.title | default: line.title | split: ' - ' | first | remove: 'Personalized Race Print' | remove: 'Personalized Race Poster' | strip %}
              {% comment %} The custom product's own name ("Custom Trackstar Print (Any Race)") says nothing about this print. {% endcomment %}
              {% if line.product_id == 10068385759515 %}{% assign race_title = 'Custom Order' %}{% endif %}
              {% assign v = line.variant.title | split: ' / ' %}
              <tr><td class="ts-in" style="padding: 16px 0 0;">
                <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; background-color: #F6F5F2; border-radius: 12px;">
                  <tr>
                    <td class="ts-mock" style="padding: 16px 0 16px 16px; vertical-align: top; width: 96px;">
                      {% if line.image %}<img src="{{ line | img_url: 'medium' }}" class="ts-mock-img" alt="{{ race_title | escape }}" width="96" style="display: block; width: 96px; height: auto; border-radius: 4px; border: 0;">{% endif %}
                    </td>
                    <td style="padding: 16px 16px 16px 16px; vertical-align: top;">
                      <p class="ts-f13" style="margin: 0 0 6px; font-size: 13px; font-weight: 500; color: #666666;">Order details</p>
                      <p class="ts-f22" style="margin: 0 0 10px; font-size: 22px; font-weight: 700; line-height: 1.1; color: #1A1A1A;">{{ race_title }}</p>
                      <div style="line-height: 34px;">
                        
                        {% if v[0] != blank and line.variant.title != 'Default Title' %}<span class="ts-chip" style="display: inline-block; margin: 0 4px 0 0; padding: 4px 9px; line-height: 1.3; border: 1px solid #E0E0E0; border-radius: 8px; background-color: #FFFFFF; white-space: nowrap; font-size: 12px; font-weight: 700; color: #1A1A1A;">{{ v[0] }}</span>{% endif %}
                        {% if v[1] != blank %}<span class="ts-chip" style="display: inline-block; margin: 0 4px 0 0; padding: 4px 9px; line-height: 1.3; border: 1px solid #1A1A1A; border-radius: 8px; background-color: #1A1A1A; white-space: nowrap; font-size: 12px; font-weight: 700; color: #FFFFFF;">{{ v[1] }}</span>{% endif %}
                      </div>
                    </td>
                  </tr>
                  <tr><td colspan="2" style="padding: 0 16px;"><div style="height: 1px; background-color: #E0E0E0;"></div></td></tr>
                  <tr>
                    <td colspan="2" style="padding: 14px 16px 16px;">
                      <table width="100%" cellpadding="0" cellspacing="0"><tr>
                        <td style="vertical-align: top;">
                          <table class="ts-f15" cellpadding="0" cellspacing="0" style="font-size: 15px; line-height: 1.5; color: #1A1A1A;">
                            <tr><td style="padding: 0 20px 0 0; color: #666666;">Runner</td><td style="font-weight: 700;">{{ runner }}</td></tr>
                            {% if p_event != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Event</td><td>{{ p_event }}</td></tr>{% endif %}
                            {% if p_year != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Year</td><td>{{ p_year }}</td></tr>{% endif %}
                            {% if p_bib != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Bib</td><td>{{ p_bib }}</td></tr>{% endif %}
                            {% if p_time != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Time</td><td>{{ p_time }}</td></tr>{% endif %}
                            {% if p_pace != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Pace</td><td>{{ p_pace }}</td></tr>{% endif %}
                          </table>
                          {% if outcome == 'race_not_yet_run' %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">We'll add the official time, pace and bib after race day.</p>
                          {% elsif p_notime != blank %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">Printed without the time and pace, as you asked.</p>
                          {% elsif p_time == blank %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">*We'll track down the official time, pace and bib for the print.</p>
                          {% endif %}
                          {% if photo_later != blank %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">Your photo: we'll email you a link to upload it the day after race day.</p>
                          {% endif %}
                        </td>
                        {% if print_photo != blank %}
                        <td class="ts-photo-cell" style="padding: 0 0 0 12px; vertical-align: top; text-align: right; width: 96px;">
                          <img class="ts-photo" src="https://fast.trackstar.art/api/public/order-photo?order={{ ship_order_id }}&amp;sig={{ ship_sig }}&amp;line={{ forloop.index0 }}" alt="Your photo for the print" width="96" height="96" style="display: inline-block; width: 96px; height: 96px; border-radius: 4px; border: 1px solid #E0E0E0; object-fit: cover;">
                          <p class="ts-f13" style="margin: 6px 0 0; font-size: 13px; color: #666666;">Your photo</p>
                        </td>
                        {% endif %}
                      </tr></table>
                    </td>
                  </tr>
                </table>
              </td></tr>
              {% endif %}
            {% endfor %}

            <tr><td class="ts-in" style="padding: 28px 0 0;">
              {% if can_manage and is_custom_order == false %}
              <p class="ts-f16" style="margin: 0 0 14px; font-size: 16px; line-height: 1.4; color: #1A1A1A;">Need to fix a name, change the frame or update your address? Click Manage your order below.</p>
              {% endif %}
              <table width="100%" cellpadding="0" cellspacing="0"><tr>
                {% if can_manage %}
                <td class="ts-btn2" style="padding: 0 10px 0 0; width: 50%;">
                  <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate;"><tr><td style="background-color: #4600D6; border-radius: 5px; text-align: center;">
                    <a class="ts-f16 ts-btn-a" href="https://fast.trackstar.art/order/{{ ship_order_id }}/{{ ship_sig }}" style="display: block; padding: 16px 12px; font-size: 16px; font-weight: 700; color: #FFFFFF !important; text-decoration: none;">Manage your order</a>
                  </td></tr></table>
                </td>
                {% endif %}
                {% if order_status_url %}
                <td class="ts-btn2" style="padding: 0; width: 50%;">
                  <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate;"><tr><td style="border: 1.5px solid #4600D6; border-radius: 5px; text-align: center;{% unless can_manage %} background-color: #4600D6;{% endunless %}">
                    <a class="ts-f16 ts-btn-a" href="{{ order_status_url }}" style="display: block; padding: 14.5px 12px; font-size: 16px; font-weight: 700; color: {% if can_manage %}#4600D6{% else %}#FFFFFF{% endif %} !important; text-decoration: none;">View your order</a>
                  </td></tr></table>
                </td>
                {% endif %}
              </tr></table>
              {% if shop.url %}
              <p class="ts-f15" style="margin: 16px 0 0; font-size: 15px; text-align: center; color: #666666;">or <a href="{{ shop.url }}" style="color: #1A1A1A !important; text-decoration: underline; text-underline-offset: 3px;">keep browsing the store</a></p>
              {% endif %}
            </td></tr>

            {% if delivery_instructions != blank %}
            <tr><td class="ts-f15 ts-in" style="padding: 16px 0 0; font-size: 15px; color: #1A1A1A;"><b>Delivery information:</b> {{ delivery_instructions }}</td></tr>
            {% endif %}

            {% assign transaction_count = transactions | size %}
            {% if transaction_count > 0 %}
              {% for transaction in transactions %}
                {% if transaction.show_buyer_pending_payment_instructions? %}
                  <tr><td class="ts-in" style="padding: 16px 0 0;">
                  <p class="ts-f15" style="font-size: 15px;">{{ transaction.buyer_pending_payment_notice }}</p>
                  <table class="row">
                    <tr>
                      {% for instruction in transaction.buyer_pending_payment_instructions %}<td>{{ instruction.header }}</td>{% endfor %}
                      <td>Amount</td>
                    </tr>
                    <tr>
                      {% for instruction in transaction.buyer_pending_payment_instructions %}<td>{{ instruction.value }}</td>{% endfor %}
                      <td>{{ transaction.amount | money }}</td>
                    </tr>
                  </table>
                  </td></tr>
                {% endif %}
              {% endfor %}
            {% endif %}

            {% assign gift_card_line_items = line_items | where: "gift_card" %}
            {% if gift_card_line_items.first %}
            <tr><td class="ts-f15 ts-in" style="padding: 16px 0 0; font-size: 15px; color: #1A1A1A;">You'll receive separate emails for any gift cards.</td></tr>
            {% endif %}

            </table>
            </td></tr>
            </table>
            </td></tr>
          </table>
          </center>

