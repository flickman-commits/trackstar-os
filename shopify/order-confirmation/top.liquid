{% comment %}
  Trackstar order confirmation, the top of the email. Everything from the
  first line of the template down to (not including) Shopify's
  <table class="row section"> that starts the Order summary. Shopify's own
  order summary and customer information blocks stay as they are; the
  <style> below restyles them. See README.md for where this goes.

  KEEP_THE_EXISTING_SECRET: the hmac_sha256 argument below is the store's
  link-signing secret. It is not in this repo; paste in the value the live
  template already has on its hmac_sha256 line.
{% endcomment %}
{% assign is_custom_order = false %}
{% assign has_preorder = false %}
{% assign preorder_note = '' %}
{% for line_item in line_items %}
  {% if line_item.product_id == 10068385759515 %}
    {% assign is_custom_order = true %}
  {% endif %}
  {% if line_item.properties['Pre-order'] != blank %}
    {% assign has_preorder = true %}
    {% assign preorder_note = line_item.properties['Pre-order'] %}
  {% endif %}
{% endfor %}

{% assign delivery_method_types = delivery_agreements | map: 'delivery_method_type' | uniq %}
{% if delivery_method_types.size > 1 %}
  {% assign has_split_cart = true %}
{% else %}
  {% assign has_split_cart = false %}
{% endif %}

{% assign ship_order_id = order.id | append: '' %}
{% assign ship_sig = ship_order_id | hmac_sha256: 'KEEP_THE_EXISTING_SECRET' %}
{% assign can_manage = false %}
{% if requires_shipping and has_pending_payment != true and delivery_method != 'pick-up' %}
  {% assign can_manage = true %}
{% endif %}
{% assign two_weeks_seconds = 1209600 %}
{% assign mockup_date = created_at | date: "%s" | plus: two_weeks_seconds | date: "%B %d, %Y" %}

{% capture email_title %}
  {% if has_pending_payment %}
    Thank you for your order
  {% else %}
    Your order is in
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="en">
  <head>
  <title>{{ email_title | strip }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap');

    /* Trackstar: Inter (Helvetica behind it), -0.04em tracking, ink on white. */
    body, .body, table, td, p, h1, h2, h3, h4, a, span, dt, dd, .button__text {
      font-family: Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
      letter-spacing: -0.04em !important;
    }
    body, .body { background-color: #FFFFFF !important; color: #1A1A1A !important; }
    .body > tbody > tr > td { background-color: #FFFFFF !important; }
    .container { width: 560px; max-width: 100%; }
    /* Shopify inlines this sheet and sets border-collapse: collapse on every table, which squares off bordered cells in Apple Mail. */
    .ts-round { border-collapse: separate !important; }
    a, a:hover, a:active, a:visited { color: #4600D6 !important; }

    /* Shopify's own blocks, restyled. */
    .header__cell, .content__cell, .section__cell, .footer__cell { padding: 0 !important; background: #FFFFFF !important; border: 0 !important; }
    .row.section { border-top: 0 !important; }
    h3 { font-size: 20px !important; font-weight: 700 !important; color: #1A1A1A !important; margin: 36px 0 12px !important; line-height: 1.15 !important; }
    h4 { font-size: 14px !important; font-weight: 500 !important; color: #666666 !important; margin: 0 0 4px !important; }
    .order-list__item { border-bottom: 1px solid #E0E0E0 !important; }
    .order-list__item-title { font-size: 16px !important; font-weight: 700 !important; color: #1A1A1A !important; }
    .order-list__item-variant, .order-list__item-discount-allocation { font-size: 14px !important; color: #666666 !important; }
    .order-list__item-price { font-size: 16px !important; font-weight: 700 !important; color: #1A1A1A !important; }
    .order-list__item-original-price { font-size: 14px !important; color: #666666 !important; }
    .order-list__product-image { border-radius: 4px !important; border: 1px solid #E0E0E0 !important; }
    .subtotal-line__title p, .subtotal-line__title span { font-size: 15px !important; color: #666666 !important; }
    .subtotal-line__value strong { font-size: 15px !important; font-weight: 500 !important; color: #1A1A1A !important; }
    .subtotal-table--total .subtotal-line__title span { color: #1A1A1A !important; font-weight: 700 !important; font-size: 18px !important; }
    .subtotal-table--total .subtotal-line__value strong { font-weight: 700 !important; font-size: 18px !important; }
    .total-discount { color: #2E7D5B !important; font-size: 14px !important; }
    .customer-info__item { padding: 12px 0 !important; }
    .customer-info__item p, .customer-info__item-content { font-size: 15px !important; color: #1A1A1A !important; line-height: 1.4 !important; }
    .disclaimer__subtext { display: none !important; }

    /* The timeline draws in one step at a time where the client runs CSS
       animation (Apple Mail, iPhone Mail). Everywhere else it is simply shown. */
    @keyframes ts-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes ts-line { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    .ts-step { animation: ts-in 0.55s ease both; }
    .ts-step-1 { animation-delay: 0.25s; }
    .ts-step-2 { animation-delay: 0.7s; }
    .ts-step-3 { animation-delay: 1.15s; }
    .ts-step-4 { animation-delay: 1.6s; }
    .ts-step-5 { animation-delay: 2.05s; }
    .ts-line { transform-origin: top; animation: ts-line 0.45s ease both; }
    .ts-line-1 { animation-delay: 0.5s; }
    .ts-line-2 { animation-delay: 0.95s; }
    .ts-line-3 { animation-delay: 1.4s; }
    .ts-line-4 { animation-delay: 1.85s; }
    @media (prefers-reduced-motion: reduce) { .ts-step, .ts-line { animation: none !important; } }

    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      /* Bigger type on phones. A lot of buyers are reading this on a small screen. */
      .ts-f12 { font-size: 14px !important; }
      .ts-f13, .ts-f14 { font-size: 16px !important; }
      .ts-f15, .ts-f16 { font-size: 18px !important; line-height: 1.4 !important; }
      .ts-f22 { font-size: 26px !important; }
      .ts-h1 { font-size: 32px !important; line-height: 1.1 !important; }
      .ts-mock { width: 72px !important; }
      .ts-photo-cell { width: 72px !important; }
      .ts-mock-img { width: 72px !important; }
      .ts-btn-a { font-size: 18px !important; padding: 18px 32px !important; }
      .order-list__item-title { font-size: 18px !important; }
      .order-list__item-variant, .order-list__item-discount-allocation, .order-list__item-original-price { font-size: 16px !important; }
      .order-list__item-price { font-size: 18px !important; }
      .subtotal-line__title p, .subtotal-line__title span, .subtotal-line__value strong { font-size: 17px !important; }
      .subtotal-table--total .subtotal-line__title span, .subtotal-table--total .subtotal-line__value strong { font-size: 20px !important; }
      .customer-info__item p, .customer-info__item-content { font-size: 17px !important; }
      h3 { font-size: 24px !important; }
      h4 { font-size: 16px !important; }
      .ts-pad { padding-left: 20px !important; padding-right: 20px !important; }
      .ts-btn { display: block !important; width: 100% !important; }
      .ts-btn a { display: block !important; text-align: center !important; }
      .ts-photo { width: 72px !important; height: 72px !important; }
    }
  </style>
</head>

  <body>
    <table class="body">
      <tr>
        <td>
          <center>
          <table class="container" cellpadding="0" cellspacing="0">
            <tr><td class="ts-pad" style="padding: 36px 0 18px; border-bottom: 1px solid #E0E0E0;">
              <table width="100%" cellpadding="0" cellspacing="0"><tr>
                <td style="vertical-align: middle;"><a href="{{ shop.url }}"><img src="https://www.trackstar.art/cdn/shop/files/Trackstar_Logo_Cropped.png" alt="Trackstar" width="140" style="display: block; width: 140px; height: auto; border: 0;"></a></td>
                <td class="ts-f15" style="vertical-align: middle; text-align: right; font-size: 15px; font-weight: 500; color: #666666;">Order {{ order_name }}</td>
              </tr></table>
            </td></tr>

            <tr><td class="ts-pad" style="padding: 28px 0 8px;">
              <h1 class="ts-f32 ts-h1" style="margin: 0 0 12px; font-size: 32px; font-weight: 700; line-height: 1.05; color: #1A1A1A;">{{ email_title | strip }}{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.</h1>
              <p class="ts-f16" style="margin: 0 0 8px; font-size: 16px; line-height: 1.4; color: #1A1A1A;">
                {% if has_pending_payment %}
                  {% if buyer_action_required %}
                    You'll get a confirmation email once your payment goes through.
                  {% else %}
                    Your payment is being processed, and you'll get an email when your order is confirmed.
                  {% endif %}
                {% elsif is_custom_order %}
                  We're excited to draw your custom print. Our team reviews the race details you sent and starts on the design, and you'll see a mockup to approve before anything prints.
                {% elsif has_preorder %}
                  The race hasn't happened yet, so your print waits for race day. Once the official results are posted we add the finish time, pace and bib, then print it.
                {% else %}
                  We've got everything we need. Here's what happens from here.
                {% endif %}
              </p>
            </td></tr>

            {% unless has_pending_payment %}
            {% comment %} What happens next. Purple numbers on white, the only purple fill on the page. {% endcomment %}
            <tr><td class="ts-pad" style="padding: 16px 0 8px;">
              <table cellpadding="0" cellspacing="0" style="border-collapse: collapse;">
                {% assign whose = 'your' %}
                {% for line in line_items %}{% if line.properties['Gift'] != blank %}{% assign whose = 'their' %}{% endif %}{% endfor %}
                {% if is_custom_order %}
                  {% assign steps = 'Today~Order confirmed|48 hrs~Change the name, frame or address. After that, our design team starts on your route|' | append: mockup_date | append: '~Your mockup arrives for approval|On approval~Printed, framed and shipped from Kentucky|7 to 10 days after approval~Delivered to ' | append: whose | append: ' doorstep' | split: '|' %}
                {% elsif has_preorder %}
                  {% assign race_day = preorder_note | remove: 'Ships after race day, ' | strip %}
                  {% assign steps = 'Today~Order confirmed|Until race day~Change the name, frame or address any time before the race|' | append: race_day | append: '~After race day, we add the official results and send your print to production|Next 7 days~Printed, framed and shipped from Kentucky|10 to 12 days after race day~Delivered to ' | append: whose | append: ' doorstep' | split: '|' %}
                {% else %}
                  {% assign steps = 'Today~Order confirmed|48 hrs~Change the name, frame or address. After that, we send your print to production|Days 3 to 7~Printed, framed and shipped from Kentucky|10 to 12 days~Delivered to ' | append: whose | append: ' doorstep' | split: '|' %}
                {% endif %}
                {% for step in steps %}
                <tr class="ts-step ts-step-{{ forloop.index }}">
                  <td style="width: 28px; padding: 0; vertical-align: top;">
                    <table cellpadding="0" cellspacing="0" style="border-collapse: collapse;"><tr>
                      <td class="ts-f14" style="width: 28px; height: 28px; border-radius: 999px; background-color: #4600D6; color: #FFFFFF; font-size: 14px; font-weight: 700; text-align: center; vertical-align: middle; line-height: 28px;">{{ forloop.index }}</td>
                    </tr>
                    {% unless forloop.last %}
                    <tr><td style="padding: 3px 0 3px 13px;"><div class="ts-line ts-line-{{ forloop.index }}" style="width: 2px; height: 16px; background-color: #E0E0E0;"></div></td></tr>
                    {% endunless %}
                    </table>
                  </td>
                  {% assign parts = step | split: '~' %}
                  <td style="padding: 0 0 0 14px; vertical-align: top;">
                    <span class="ts-f12" style="display: inline-block; margin: 5px 0 3px; padding: 1px 8px; border-radius: 999px; background-color: #F6F5F2; font-size: 12px; font-weight: 700; line-height: 1.4; color: #4600D6;">{{ parts[0] }}</span>
                    <div class="ts-f16" style="padding: 0 0 6px; font-size: 16px; line-height: 1.3; color: #1A1A1A;{% if forloop.first %} font-weight: 700;{% endif %}">{{ parts[1] }}</div>
                  </td>
                </tr>
                {% endfor %}
              </table>
            </td></tr>
            {% endunless %}

            {% comment %} The prints: the details that will be on them, from the order's line item properties. {% endcomment %}
            {% for line in line_items %}
              {% assign is_addon = false %}
              {% if line.properties['_addon_for'] != blank or line.title contains 'Photo Add-On' or line.gift_card %}{% assign is_addon = true %}{% endif %}
              {% assign runner = line.properties['Runner Name (First & Last)'] %}
              {% if is_addon == false and runner != blank %}
              {% assign print_photo = line.properties['_photo_path'] %}
              {% assign photo_later = line.properties['_photo_later'] %}
              {% assign outcome = line.properties['_lookup_outcome'] %}
              {% assign race_title = line.title | remove: 'Personalized Race Print' | remove: 'Personalized Race Poster' | strip %}
              {% assign v = line.variant.title | split: ' / ' %}
              <tr><td class="ts-pad" style="padding: 16px 0 0;">
                <table class="ts-round" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; background-color: #FFFFFF; border: 1px solid #E0E0E0; border-radius: 12px;">
                  <tr>
                    <td class="ts-mock" style="padding: 16px 0 16px 16px; vertical-align: top; width: 96px;">
                      {% if line.image %}<img src="{{ line | img_url: 'medium' }}" class="ts-mock-img" alt="{{ race_title | escape }}" width="96" style="display: block; width: 96px; height: auto; border-radius: 4px; border: 0;">{% endif %}
                    </td>
                    <td style="padding: 16px 16px 16px 16px; vertical-align: top;">
                      <p class="ts-f13" style="margin: 0 0 6px; font-size: 13px; font-weight: 500; color: #666666;">Order details</p>
                      <p class="ts-f22" style="margin: 0 0 10px; font-size: 22px; font-weight: 700; line-height: 1.1; color: #1A1A1A;">{{ race_title }}</p>
                      <div style="line-height: 44px;">
                        {% if line.properties['Race Year'] != blank %}<span class="ts-f15" style="display: inline-block; margin: 0 4px 0 0; padding: 6px 12px; line-height: 1.3; border: 1px solid #E0E0E0; border-radius: 8px; white-space: nowrap; font-size: 15px; font-weight: 700; color: #1A1A1A;">{{ line.properties['Race Year'] }}</span>{% endif %}
                        {% if v[0] != blank and line.variant.title != 'Default Title' %}<span class="ts-f15" style="display: inline-block; margin: 0 4px 0 0; padding: 6px 12px; line-height: 1.3; border: 1px solid #E0E0E0; border-radius: 8px; white-space: nowrap; font-size: 15px; font-weight: 700; color: #1A1A1A;">{{ v[0] }}</span>{% endif %}
                        {% if v[1] != blank %}<span class="ts-f15" style="display: inline-block; margin: 0 4px 0 0; padding: 6px 12px; line-height: 1.3; border: 1px solid #1A1A1A; border-radius: 8px; background-color: #1A1A1A; white-space: nowrap; font-size: 15px; font-weight: 700; color: #FFFFFF;">{{ v[1] }}</span>{% endif %}
                      </div>
                    </td>
                  </tr>
                  <tr><td colspan="2" style="padding: 0 16px;"><div style="height: 1px; background-color: #E0E0E0;"></div></td></tr>
                  <tr>
                    <td colspan="2" style="padding: 14px 16px 16px;">
                      <table width="100%" cellpadding="0" cellspacing="0"><tr>
                        <td style="vertical-align: top;">
                          <table class="ts-f15" cellpadding="0" cellspacing="0" style="font-size: 15px; line-height: 1.5; color: #1A1A1A;">
                            <tr><td style="padding: 0 20px 0 0; color: #666666;">Runner</td><td style="font-weight: 700;">{{ runner }}</td></tr>
                            {% if line.properties['Event'] != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Event</td><td>{{ line.properties['Event'] }}</td></tr>{% endif %}
                            {% if line.properties['Bib #'] != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Bib</td><td>{{ line.properties['Bib #'] }}</td></tr>{% endif %}
                            {% if line.properties['Time'] != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Time</td><td>{{ line.properties['Time'] }}</td></tr>{% endif %}
                            {% if line.properties['Pace'] != blank %}<tr><td style="padding: 0 20px 0 0; color: #666666;">Pace</td><td>{{ line.properties['Pace'] }}</td></tr>{% endif %}
                          </table>
                          {% if outcome == 'race_not_yet_run' %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">We'll add the official time, pace and bib after race day.</p>
                          {% elsif line.properties['No Time'] != blank %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">Printed without the time and pace, as you asked.</p>
                          {% elsif line.properties['Time'] == blank %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">We'll track down the official time, pace and bib for the print.</p>
                          {% endif %}
                          {% if photo_later != blank %}
                            <p class="ts-f14" style="margin: 10px 0 0; font-size: 14px; line-height: 1.4; color: #666666;">Your photo: we'll email you a link to upload it the day after race day.</p>
                          {% endif %}
                        </td>
                        {% if print_photo != blank %}
                        <td class="ts-photo-cell" style="padding: 0 0 0 12px; vertical-align: top; text-align: right; width: 96px;">
                          <img class="ts-photo" src="https://fast.trackstar.art/api/public/order-photo?order={{ ship_order_id }}&amp;sig={{ ship_sig }}&amp;line={{ forloop.index0 }}" alt="Your photo for the print" width="96" height="96" style="display: inline-block; width: 96px; height: 96px; border-radius: 4px; border: 1px solid #E0E0E0; object-fit: cover;">
                          <p class="ts-f13" style="margin: 6px 0 0; font-size: 13px; color: #666666;">Your photo</p>
                        </td>
                        {% endif %}
                      </tr></table>
                    </td>
                  </tr>
                </table>
              </td></tr>
              {% endif %}
            {% endfor %}

            {% if can_manage %}
            <tr><td class="ts-pad" style="padding: 28px 0 0;">
              <p class="ts-f16" style="margin: 0 0 12px; font-size: 16px; line-height: 1.4; color: #1A1A1A;">Need to fix a name, change the frame or update your address? You can {% if has_preorder %}any time before race day{% else %}for 48 hours after ordering{% endif %}.</p>
              <table class="ts-btn ts-round" cellpadding="0" cellspacing="0"><tr><td>
                <a class="ts-f16 ts-btn-a" href="https://fast.trackstar.art/order/{{ ship_order_id }}/{{ ship_sig }}" style="display: inline-block; padding: 16px 32px; border: 1.5px solid #4600D6; border-radius: 5px; font-size: 16px; font-weight: 700; color: #4600D6; text-decoration: none;">Manage your order</a>
              </td></tr></table>
            </td></tr>
            {% endif %}

            {% if delivery_instructions != blank %}
            <tr><td class="ts-f15 ts-pad" style="padding: 16px 0 0; font-size: 15px; color: #1A1A1A;"><b>Delivery information:</b> {{ delivery_instructions }}</td></tr>
            {% endif %}

            {% assign transaction_count = transactions | size %}
            {% if transaction_count > 0 %}
              {% for transaction in transactions %}
                {% if transaction.show_buyer_pending_payment_instructions? %}
                  <tr><td class="ts-pad" style="padding: 16px 0 0;">
                  <p class="ts-f15" style="font-size: 15px;">{{ transaction.buyer_pending_payment_notice }}</p>
                  <table class="row">
                    <tr>
                      {% for instruction in transaction.buyer_pending_payment_instructions %}<td>{{ instruction.header }}</td>{% endfor %}
                      <td>Amount</td>
                    </tr>
                    <tr>
                      {% for instruction in transaction.buyer_pending_payment_instructions %}<td>{{ instruction.value }}</td>{% endfor %}
                      <td>{{ transaction.amount | money }}</td>
                    </tr>
                  </table>
                  </td></tr>
                {% endif %}
              {% endfor %}
            {% endif %}

            {% assign gift_card_line_items = line_items | where: "gift_card" %}
            {% if gift_card_line_items.first %}
            <tr><td class="ts-f15 ts-pad" style="padding: 16px 0 0; font-size: 15px; color: #1A1A1A;">You'll receive separate emails for any gift cards.</td></tr>
            {% endif %}

            <tr><td class="ts-f15 ts-pad" style="padding: 20px 0 8px; font-size: 15px; color: #666666;">
              {% if order_status_url %}<a href="{{ order_status_url }}" style="color: #4600D6; font-weight: 700; text-decoration: underline; text-underline-offset: 4px;">View your order</a>{% if shop.url %} &nbsp;&middot;&nbsp; {% endif %}{% endif %}
              {% if shop.url %}<a href="{{ shop.url }}" style="color: #4600D6; font-weight: 700; text-decoration: underline; text-underline-offset: 4px;">Visit our store</a>{% endif %}
            </td></tr>
          </table>
          </center>

