# ─── Database (Supabase + Prisma) ───
DATABASE_URL="postgresql://your-connection-string-here?pgbouncer=true"
DIRECT_URL="postgresql://your-direct-connection-string-here"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Shopify API (Client Credentials Flow) ───
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-shopify-client-id-here
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret-here

# ─── Etsy API (OAuth 2.0 + PKCE) ───
ETSY_API_KEY=your-etsy-api-key-here
ETSY_SHARED_SECRET=your-etsy-shared-secret-here
ETSY_SHOP_ID=your-etsy-shop-id-here

# ─── Artelo API ───
ARTELO_API_KEY=your-artelo-api-key-here
# Minutes an approved print waits before it is attached and sent to Artelo production, so a wrong click can be held (default 5)
ARTELO_SEND_HOLD_MINUTES=5

# ─── Gelato API (overseas samples) ───
# Gelato dashboard > Developer > API Keys. Sent as the X-API-KEY header.
GELATO_API_KEY=your-gelato-api-key-here

# ─── Slack Webhooks ───
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-here
SLACK_PROOF_WEBHOOK_URL=https://hooks.slack.com/services/your-proof-webhook-here
SLACK_DM_WEBHOOK_URL=https://hooks.slack.com/services/your-dm-webhook-here
# Month-end custom statements: one incoming webhook per designer, pointed at
# their DM (server/domain/orders/customStatements.js).
SLACK_DAN_DM_WEBHOOK_URL=https://hooks.slack.com/services/dan-dm-webhook
SLACK_CREED_DM_WEBHOOK_URL=https://hooks.slack.com/services/creed-dm-webhook
SLACK_FRANK_DM_WEBHOOK_URL=https://hooks.slack.com/services/frank-dm-webhook

# ─── Email (Resend) ───
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Trackstar <proofs@orders.trackstar.art>

# ─── Auth (server-side only — never exposed to the browser) ───
ADMIN_SECRET=your-admin-secret-here          # server-to-server header auth (crons, tooling)
ADMIN_PASSWORD=your-admin-password-here      # browser login password (checked server-side)
SESSION_SECRET=your-session-signing-secret   # HMAC key for session cookies; falls back to ADMIN_SECRET
CRON_SECRET=your-cron-secret-here

# ─── Client-side (VITE_ prefix required — these ARE shipped to the browser) ───
# Leave VITE_API_URL empty: the Vite dev proxy forwards /api to localhost:3001
# same-origin, so the session cookie is sent. Setting an absolute URL makes API
# calls cross-origin and the cookie won't ride along.
VITE_API_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Trackstar MCP ───────────────────────────────────────────────────────────
# The MCP server at /api/mcp is reached with API keys minted in Settings >
# Admin > API Keys (stored hashed; nothing to set here). These two are the
# tokens from before keys existed and still work as service keys: MCP_TOKEN
# reads, MCP_WRITE_TOKEN reads and repairs. Delete both once the nightly
# routine has a real key.
MCP_TOKEN=
MCP_WRITE_TOKEN=

# ─── Sales tool ───────────────────────────────────────────────────────────────
# Attio is the CRM and the source of truth. The Sales page reads the queue
# from it live (deals, people, the company's enrichment) and writes back on
# every send: touch count, next action, Reached Out, and a note with the
# email. Workspace API token from Attio > Settings > Developers, with read and
# write on records and notes. Server-side only; each rep's Gmail is their own.
# A rep gets into Sales when their app login email is a member of the
# workspace, so add reps in Attio, not here.
ATTIO_API_KEY=
# Optional: the api_slug of the people list PR is worked from (default press_outreach).
# ATTIO_PR_LIST=press_outreach
# Model behind Rewrite and "Change it" (server/lib/llm.js). Anthropic by
# default; set LLM_PROVIDER=openai + LLM_BASE_URL for Ollama/vLLM/OpenAI.
# Without one the page uses the cadence templates, filled from Attio.
ANTHROPIC_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# The library (decks, mockups) lives in a private Supabase bucket, sales-assets,
# on the SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above. Which image to attach
# when nothing in the library matches the deal's name or notes: a filename as
# uploaded, e.g. NYC_SIR_Mockup.png. Unset means the first image.
SALES_DEFAULT_MOCKUP=
# New outreach per rep per day. Also editable in Settings. The runbook says 10.
SALES_DAILY_CAP=
# Sends go through each rep's own Gmail: OAuth client from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Canonical public origin. Already set in Vercel; used for the OAuth redirect,
# invite links and Slack deep links.
APP_BASE_URL=

# ─── Support inbox ────────────────────────────────────────────────────────────
# The shared mailbox the Support page mirrors and replies from. Connected once
# by an admin signed in to Google as that account (same OAuth client as
# Sales; add https://fast.trackstar.art/api/support/gmail-callback and the
# localhost one as redirect URIs). Connecting as any other account is refused.
SUPPORT_MAILBOX_EMAIL=fast@trackstar.art
# Claude drafts a reply for each new support email (server/domain/support/draft.js),
# on ANTHROPIC_API_KEY above. Model for drafting; default claude-haiku-5-5
# (about a fifth of a cent a draft). Set SUPPORT_DRAFTS=off to stop drafting.
SUPPORT_LLM_MODEL=
SUPPORT_DRAFTS=
# Instagram DMs to @trackstar_art, the inbox's second channel. One Meta app
# (developers.facebook.com > My Apps > Create app > "Other" > Business) with
# the "Instagram" product added, set up as "API setup with Instagram login".
# App ID and App secret: App Dashboard > App settings > Basic.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# A string you invent; paste the same one into Instagram > API setup with
# Instagram login > step 2 "Configure webhooks" (callback URL
# https://fast.trackstar.art/api/support/instagram-webhook, subscribe to
# messages and message_echoes). Meta sends it back on verification.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# The professional account the grant must be for, without the @. Connecting
# as another account is refused. The token itself is not an env var: an
# admin signs in from the Support page (redirect URI
# https://fast.trackstar.art/api/support/instagram-callback must be listed
# under "Business login settings"), or pastes the long-lived token from
# "Generate token" in the dashboard. It is stored in SystemConfig and kept
# alive by the support sync cron.
INSTAGRAM_HANDLE=trackstar_art
# Set to true only once Meta has approved the "Human Agent" permission
# (App Review). It lets a reply go out up to 7 days after the customer's
# message instead of 24 hours. Unset, the page says the window has closed.
INSTAGRAM_HUMAN_AGENT_APPROVED=
# Graph API version for graph.instagram.com. Leave unset for the default.
INSTAGRAM_GRAPH_VERSION=

# Shopify product id of the "Rush Order" (skip the line) add-on. Optional:
# rush is also detected from the print's "Rush Order" property and from the
# add-on's title, so the feature works before this is set. Setting it makes
# detection exact and survives renaming the product.
RUSH_ADDON_PRODUCT_ID=

# Nightly scraper repair (server/lib/previewProbe.js). Production uses these to
# find a branch's preview deployment and wait for a deploy: a Vercel access
# token, the project id (Project Settings > General) and, for a team, its id.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Shared by production and previews so a preview will run a probe for
# production and nobody else. Set it for BOTH Production and Preview.
PREVIEW_PROBE_SECRET=
# Only if Deployment Protection is on: enable "Protection Bypass for
# Automation" and Vercel provides this to production automatically.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Extra timing-site hosts fetch_timing_page may reach, comma-separated, for a
# new platform before its host is added to server/lib/scraperTrace.js.
TIMING_HOSTS_EXTRA=

# Google Drive folder for approved custom designs (defaults to the team gallery).
# Needs the Drive API enabled and the folder shared with GOOGLE_SERVICE_ACCOUNT_EMAIL.
CUSTOM_GALLERY_FOLDER_ID=

# Drive folder approved automated renders are saved to (defaults to the shop's Orders folder).
RENDER_ORDERS_FOLDER_ID=

# ---------------------------------------------------------------------------
# Read by the code but missing from this file until the 2026-10-20 audit.
# ---------------------------------------------------------------------------
# Public base URL of the app, used in links the server writes (invites,
# creator review links, OAuth returns). Set it; never derive it from headers.
APP_URL=
# The nightly agent's narrow token (api/_lib/agentToken.js).
AGENT_TOKEN=
# A token that can only read the stored nightly report (the daily digest).
NIGHTLY_REPORT_READ_TOKEN=
# Slack webhook for the nightly sweep summary.
NIGHTLY_SWEEP_SLACK=
# Etsy: the shop the connection must belong to (api/etsy/auth.js refuses any
# other), and an optional bootstrap refresh token before one is stored.
ETSY_REFRESH_TOKEN=
# Google service account for Drive and Sheets (deliveries, the custom gallery,
# the Monopoly sheet). The key is the JSON, on one line.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Artelo: the library folder approved prints are uploaded to, and the
# per-order branding charge used when estimating sample costs (dollars).
ARTELO_UPLOAD_FOLDER=
ARTELO_BRANDING_COST=
# Attio: API host override (tests) and the PR Pipeline list slug.
ATTIO_BASE_URL=
ATTIO_PR_LIST=
# Claude through a gateway, when not using ANTHROPIC_API_KEY directly.
ANTHROPIC_AUTH_TOKEN=
# Optional OpenAI-compatible key for server/lib/llm.js.
OPENAI_API_KEY=
# Feature gates.
PUBLIC_LOOKUP_ENABLED=
PHOTO_UPLOAD_ENABLED=
MONOPOLY_PAGE_ENABLED=
# Marathon Monopoly: the sheet it reads, and the key in Matt's direct link.
MONOPOLY_SHEET_ID=
MONOPOLY_ACCESS_KEY=
# The photo add-on product and variant in Shopify.
PHOTO_ADDON_PRODUCT_ID=
PHOTO_ADDON_VARIANT_ID=
# Where customer replies to proof emails go.
PROOF_REPLY_TO_EMAIL=
# Slack webhooks and the user id pinged on creator requests.
SLACK_CREATORS_WEBHOOK_URL=
SLACK_DESIGN_WEBHOOK_URL=
SLACK_ELI_DM_WEBHOOK_URL=
SLACK_LOOKUP_WEBHOOK_URL=
SLACK_USER_ID_MATT=
